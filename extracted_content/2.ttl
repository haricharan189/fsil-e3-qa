@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:bofa_securities_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:bookrunners,
        org_role:lead_arrangers,
        org_role:syndication_agent .

org1:national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_documentation_agent .

org1:pnc_bank a base:Organization .

org1:td_securities_usa_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_documentation_agent .

org1:us_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_documentation_agent .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:arrangers,
        org_role:bookrunners .

loc:new_york a base:Location ;
    rel:isLocationOf org1:the_toronto_dominion_bank .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:arrangers rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:syndication_agent rdfs:subClassOf base:Organization .

person:adam_j_kultgen a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:u_s_bank_national_association ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:u_s_bank_national_association .

person:alysa_trakas a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:truist_bank ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:truist_bank .

person:anthony_hoye a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:carl_hinrichs a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_bank_national_association ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:wells_fargo_bank_national_association .

person:carl_s_tabacjar_jr a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citizens_bank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:citizens_bank_na .

person:jaime_mariano a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:hsbc_bank_usa_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:hsbc_bank_usa_na .

person:mary_f_molnar a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:pnc_bank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:pnc_bank_national_association .

person:mary_ramsey a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director_svp ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:fifth_third_bank_national_association ;
            rel:position position:managing_director_svp ] ;
    rel:isEmployedBy org1:fifth_third_bank_national_association .

person:michael_borowiecki a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:the_toronto_dominion_bank ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:the_toronto_dominion_bank .

person:navdeep_gupta a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer,
        position:executive_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:dicks_sporting_goods_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:dicks_sporting_goods_inc ;
            rel:position position:executive_vice_president ] ;
    rel:isEmployedBy org1:dicks_sporting_goods_inc .

person:paul_isaac a base:Person ;
    <http://example.org/isInstanceOf/> position:duly_authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:capital_one_na ;
            rel:position position:duly_authorized_signatory ] ;
    rel:isEmployedBy org1:capital_one_na .

person:phil_andresen a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:the_huntington_national_bank ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:the_huntington_national_bank .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:issuing_lender ;
    rel:hasEmployee person:anthony_hoye .

org1:capital_one_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:paul_isaac .

org1:citizens_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:carl_s_tabacjar_jr .

org1:fifth_third_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:mary_ramsey .

org1:hsbc_bank_usa_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:jaime_mariano .

org1:pnc_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:mary_f_molnar .

org1:the_huntington_national_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:phil_andresen .

org1:truist_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:alysa_trakas .

org1:u_s_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:adam_j_kultgen .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender ;
    rel:hasEmployee person:carl_hinrichs .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:bookrunners rdfs:subClassOf base:Organization .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

position:duly_authorized_signatory a base:Position ;
    base:positionName "Duly Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:executive_vice_president a base:Position ;
    base:positionName "Executive Vice President" ;
    rdfs:subClassOf base:Person .

position:managing_director_svp a base:Position ;
    base:positionName "Managing Director, SVP" ;
    rdfs:subClassOf base:Person .

org1:dicks_sporting_goods_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:navdeep_gupta .

org1:the_toronto_dominion_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:michael_borowiecki ;
    rel:hasLocationAt loc:new_york .

org_role:co_documentation_agent rdfs:subClassOf base:Organization .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

