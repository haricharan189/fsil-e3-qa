@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:apollo_capital_management_lp a base:Organization .

org1:midcap_financial_trust a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender .

loc:7255_woodmont_avenue_suite_200_bethesda_maryland_20814 a base:Location ;
    rel:isLocationOf org1:midcap_financial_services .

loc:moduslink_corporation_1601_trapelo_road_suite_170_waltham_massachusetts_02451 a base:Location ;
    rel:isLocationOf org1:moduslink_corporation .

org1:midcap_financial_services a base:Organization ;
    rel:hasLocationAt loc:7255_woodmont_avenue_suite_200_bethesda_maryland_20814 .

org_role:agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:borrowers rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:maurice_amsellem a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:apollo_capital_management_gp_llc ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:apollo_capital_management_gp_llc .

org1:apollo_capital_management_gp_llc a base:Organization ;
    rel:hasEmployee person:maurice_amsellem .

org1:saleslink_mexico_holding_corp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:peter_feret .

org1:sol_holdings_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:peter_feret .

org_role:guarantors rdfs:subClassOf base:Organization .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

org1:moduslink_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower,
        org_role:borrowers ;
    rel:hasEmployee person:peter_feret ;
    rel:hasLocationAt loc:moduslink_corporation_1601_trapelo_road_suite_170_waltham_massachusetts_02451 .

person:peter_feret a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:saleslink_mexico_holding_corp ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:moduslink_corporation ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:sol_holdings_inc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:moduslink_corporation,
        org1:saleslink_mexico_holding_corp,
        org1:sol_holdings_inc .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

