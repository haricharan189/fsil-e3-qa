@prefix base: <http://example.org/base/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:delaware_corporation a base:Organization .

org1:delaware_limited_liability_company a base:Organization .

org1:five_oaks_acquisition_corp_and_hunt_cmt_equity_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors .

org1:maryland_corporation a base:Organization .

org_role:agent rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lenders rdfs:subClassOf base:Organization .

person:emily_ergang_pappas a base:Person ;
    <http://example.org/isInstanceOf/> position:associate_counsel ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:cortland_capital_market_services_llc ;
            rel:position position:associate_counsel ] ;
    rel:isEmployedBy org1:cortland_capital_market_services_llc .

person:william_p_mcloughlin a base:Person ;
    <http://example.org/isInstanceOf/> position:svp ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jefferies_leveraged_credit_products_llc ;
            rel:position position:svp ] ;
    rel:isEmployedBy org1:jefferies_leveraged_credit_products_llc .

org1:cortland_capital_market_services_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:collateral_agent,
        org_role:lenders ;
    rel:hasEmployee person:emily_ergang_pappas .

org1:five_oaks_acquisition_corp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor,
        org_role:guarantors ;
    rel:hasEmployee person:michael_larsen .

org1:hunt_cmt_equity_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor,
        org_role:guarantors ;
    rel:hasEmployee person:michael_larsen .

org1:hunt_companies_finance_trust_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:michael_larsen .

org1:jefferies_leveraged_credit_products_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:initial_lender ;
    rel:hasEmployee person:william_p_mcloughlin .

org_role:guarantor rdfs:subClassOf base:Organization .

position:associate_counsel a base:Position ;
    base:positionName "Associate Counsel" ;
    rdfs:subClassOf base:Person .

position:svp a base:Position ;
    base:positionName "SVP" ;
    rdfs:subClassOf base:Person .

org_role:guarantors rdfs:subClassOf base:Organization .

person:michael_larsen a base:Person ;
    <http://example.org/isInstanceOf/> position:president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:five_oaks_acquisition_corp ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:hunt_cmt_equity_llc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:hunt_companies_finance_trust_inc ;
            rel:position position:president ] ;
    rel:isEmployedBy org1:five_oaks_acquisition_corp,
        org1:hunt_cmt_equity_llc,
        org1:hunt_companies_finance_trust_inc .

position:president a base:Position ;
    base:positionName "President" ;
    rdfs:subClassOf base:Person .

