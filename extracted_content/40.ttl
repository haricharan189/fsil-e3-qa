@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:jp_morgan_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:bookrunners .

org1:keybanc_capital_markets_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:joint_bookrunners .

org_role:agent rdfs:subClassOf base:Organization .

person:nida_mischke a base:Person .

loc:10_south_dearborn_street_floor_l2_chicago_il_60603_2003 a base:Location ;
    rel:isLocationOf org1:jpmorgan_chase_bank_na .

loc:59_maiden_lane_38th_floor_new_york_ny_10038 a base:Location ;
    rel:isLocationOf org1:national_general_holdings_corp .

org_role:bookrunners rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:issuing_bank rdfs:subClassOf base:Organization .

org_role:syndication_agent rdfs:subClassOf base:Organization .

person:david_reading a base:Person ;
    <http://example.org/isInstanceOf/> position:first_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:first_niagara_bank_na ;
            rel:position position:first_vice_president ] ;
    rel:isEmployedBy org1:first_niagara_bank_na .

person:edward_j_chidiac a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:associated_bank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:associated_bank_national_association .

person:hector_j_varona a base:Person ;
    <http://example.org/isInstanceOf/> position:executive_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank_na ;
            rel:position position:executive_director ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank_na .

person:james_cribbet a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:keybank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:keybank_national_association .

person:kevin_chan a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:the_bank_of_novia_scotia ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:the_bank_of_novia_scotia .

person:michael_h_weiner a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:national_general_holdings_corp ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:national_general_holdings_corp .

person:michael_king a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:morgan_stanley_bank_na ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:morgan_stanley_bank_na .

org1:associated_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_documentation_agent,
        org_role:lender ;
    rel:hasEmployee person:edward_j_chidiac .

org1:first_niagara_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_documentation_agent,
        org_role:lender ;
    rel:hasEmployee person:david_reading .

org1:keybank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender,
        org_role:syndication_agent ;
    rel:hasEmployee person:james_cribbet .

org1:morgan_stanley_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:michael_king .

org1:the_bank_of_novia_scotia a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:kevin_chan .

org_role:arrangers rdfs:subClassOf base:Organization .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:executive_director a base:Position ;
    base:positionName "Executive Director" ;
    rdfs:subClassOf base:Person .

position:first_vice_president a base:Position ;
    base:positionName "First Vice President" ;
    rdfs:subClassOf base:Person .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:issuing_bank,
        org_role:lender ;
    rel:hasEmployee person:hector_j_varona ;
    rel:hasLocationAt loc:10_south_dearborn_street_floor_l2_chicago_il_60603_2003 .

org1:national_general_holdings_corp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:michael_h_weiner ;
    rel:hasLocationAt loc:59_maiden_lane_38th_floor_new_york_ny_10038 .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

