@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:regions_capital_markets a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:bookrunners .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:bookrunners .

loc:10_south_wacker_drive_chicago_il_60606 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

loc:518_17th_street_suite_1700_denver_co_80202 a base:Location ;
    rel:isLocationOf org1:black_creek_diversified_property_operating_partnership_lp .

loc:minneapolis_loan_center_mac_n9300_091_600_south_4thstreet_9thfloor_minneapolis_minnesota_55415 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:documentation_agent rdfs:subClassOf base:Organization .

org_role:syndication_agent rdfs:subClassOf base:Organization .

person:craig_v_koshkarian a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_bank_national_association ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:wells_fargo_bank_national_association .

person:dennis_szczesuil a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:raymond_james_bank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:raymond_james_bank_na .

person:elizabeth_dove a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:capital_one_national_association ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:capital_one_national_association .

person:ghi_gavin a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:regions_bank ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:regions_bank .

person:katherine_davidson a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:mufg_union_bank_na ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:mufg_union_bank_na .

person:kevin_a_stacker a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_bank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:wells_fargo_bank_national_association .

person:lainie_minnick a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer,
        position:managing_director,
        position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:black_creek_diversified_property_operating_partnership_lp ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:black_creek_diversified_property_operating_partnership_lp ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:black_creek_diversified_property_operating_partnership_lp ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:black_creek_diversified_property_operating_partnership_lp .

org1:capital_one_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agent,
        org_role:lender ;
    rel:hasEmployee person:elizabeth_dove .

org1:mufg_union_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:katherine_davidson .

org1:raymond_james_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:dennis_szczesuil .

org1:regions_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender,
        org_role:syndication_agent ;
    rel:hasEmployee person:ghi_gavin .

org_role:arrangers rdfs:subClassOf base:Organization .

org_role:bookrunners rdfs:subClassOf base:Organization .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:managing_director a base:Position ;
    base:positionName "Managing Director" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:black_creek_diversified_property_operating_partnership_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:lainie_minnick ;
    rel:hasLocationAt loc:518_17th_street_suite_1700_denver_co_80202 .

org_role:lender rdfs:subClassOf base:Organization .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender ;
    rel:hasEmployee person:craig_v_koshkarian,
        person:kevin_a_stacker ;
    rel:hasLocationAt loc:10_south_wacker_drive_chicago_il_60606,
        loc:minneapolis_loan_center_mac_n9300_091_600_south_4thstreet_9thfloor_minneapolis_minnesota_55415 .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

