loc:580_white_plains_road_suite_610_tarrytown_ny_10591 a base:Location ;
    rel:isLocationOf org1:keltic_financial_partners_ii_lp .

org1:keltic_financial_partners_ii_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasLocationAt loc:580_white_plains_road_suite_610_tarrytown_ny_10591 .

org_role:lender rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

