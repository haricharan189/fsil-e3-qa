@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org_role:agent rdfs:subClassOf base:Organization .

org_role:bookrunner rdfs:subClassOf base:Organization .

org_role:manager rdfs:subClassOf base:Organization .

loc:200_west_street_new_york_new_york_10282_2198 a base:Location ;
    rel:isLocationOf org1:goldman_sachs_bank_usa .

loc:30_hudson_street_36th_floor_jersey_city_nj_07302 a base:Location ;
    rel:isLocationOf org1:goldman_sachs_bank_usa .

loc:c_o_goldman_sachsand_co_30_hudson_street_36th_floor_jersey_city_nj_07302 a base:Location ;
    rel:isLocationOf org1:goldman_sachs_bank_usa .

org1:itc_holdings_corp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:sole_manager ;
    rel:hasLocationAt loc:27175_energy_way_novi_mi_48377 .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:cameron_m_bready a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer,
        position:executive_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:michigan_electric_transmission_company_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:michigan_electric_transmission_company_llc ;
            rel:position position:executive_vice_president ] ;
    rel:isEmployedBy org1:michigan_electric_transmission_company_llc .

person:rejji_p_hayes a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president_finance_and_treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:michigan_electric_transmission_company_llc ;
            rel:position position:vice_president_finance_and_treasurer ] ;
    rel:isEmployedBy org1:michigan_electric_transmission_company_llc .

person:wendy_a_mcintyre a base:Person ;
    <http://example.org/isInstanceOf/> position:general_counsel,
        position:secretary,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:michigan_electric_transmission_company_llc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:michigan_electric_transmission_company_llc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:michigan_electric_transmission_company_llc ;
            rel:position position:general_counsel ] ;
    rel:isEmployedBy org1:michigan_electric_transmission_company_llc .

loc:27175_energy_way_novi_mi_48377 a base:Location ;
    rel:isLocationOf org1:itc_holdings_corp,
        org1:michigan_electric_transmission_company_llc .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

position:executive_vice_president a base:Position ;
    base:positionName "Executive Vice President" ;
    rdfs:subClassOf base:Person .

position:general_counsel a base:Position ;
    base:positionName "General Counsel" ;
    rdfs:subClassOf base:Person .

position:secretary a base:Position ;
    base:positionName "Secretary" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

position:vice_president_finance_and_treasurer a base:Position ;
    base:positionName "Vice President, Finance and Treasurer" ;
    rdfs:subClassOf base:Person .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:arranger,
        org_role:lender,
        org_role:sole_bookrunner ;
    rel:hasLocationAt loc:200_west_street_new_york_new_york_10282_2198,
        loc:30_hudson_street_36th_floor_jersey_city_nj_07302,
        loc:c_o_goldman_sachsand_co_30_hudson_street_36th_floor_jersey_city_nj_07302 .

org1:michigan_electric_transmission_company_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:cameron_m_bready,
        person:rejji_p_hayes,
        person:wendy_a_mcintyre ;
    rel:hasLocationAt loc:27175_energy_way_novi_mi_48377 .

