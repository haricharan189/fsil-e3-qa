            rel:organization org1:angelo_gordon_energy_servicer_llc ;
            rel:position position:authorized_person ],
        [ a rel:Employment ;
            rel:organization org1:ag_energy_funding_llc ;
            rel:position position:authorized_person ] ;
    rel:isEmployedBy org1:ag_energy_funding_llc,
