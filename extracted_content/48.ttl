@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:jonathan_rose a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:enbridge_energy_partners_lp ;
            rel:position position:treasurer ] ;
    rel:isEmployedBy org1:enbridge_energy_partners_lp .

person:stephen_j_neyland a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president_finance ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:enbridge_energy_management_llc ;
            rel:position position:vice_president_finance ] ;
    rel:isEmployedBy org1:enbridge_energy_management_llc .

loc:1100_louisiana_suite_3300_houston_tx_77002_5217 a base:Location ;
    rel:isLocationOf org1:enbridge_energy_partners_lp,
        org1:enbridge_us_inc .

loc:c_o_enbridge_inc_3000_425_1st_calgary_alberta_canada a base:Location ;
    rel:isLocationOf org1:enbridge_energy_partners_lp,
        org1:enbridge_us_inc .

org1:enbridge_energy_management_llc a base:Organization ;
    rel:hasEmployee person:stephen_j_neyland .

person:chris_kaitson a base:Person ;
    <http://example.org/isInstanceOf/> position:corporate_secretary,
        position:vice_president_law_and_assistant,
        position:vice_president_us_law ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:enbridge_energy_partners_lp ;
            rel:position position:vice_president_us_law ],
        [ a rel:Employment ;
            rel:organization org1:enbridge_us_inc ;
            rel:position position:corporate_secretary ],
        [ a rel:Employment ;
            rel:organization org1:enbridge_us_inc ;
            rel:position position:vice_president_law_and_assistant ] ;
    rel:isEmployedBy org1:enbridge_energy_partners_lp,
        org1:enbridge_us_inc .

position:corporate_secretary a base:Position ;
    base:positionName "Corporate Secretary" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

position:vice_president_finance a base:Position ;
    base:positionName "Vice President-Finance" ;
    rdfs:subClassOf base:Person .

position:vice_president_law_and_assistant a base:Position ;
    base:positionName "Vice President – Law & Assistant" ;
    rdfs:subClassOf base:Person .

position:vice_president_us_law a base:Position ;
    base:positionName "Vice President – US Law" ;
    rdfs:subClassOf base:Person .

org1:enbridge_us_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:chris_kaitson ;
    rel:hasLocationAt loc:1100_louisiana_suite_3300_houston_tx_77002_5217,
        loc:c_o_enbridge_inc_3000_425_1st_calgary_alberta_canada .

org1:enbridge_energy_partners_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:chris_kaitson,
        person:jonathan_rose ;
    rel:hasLocationAt loc:1100_louisiana_suite_3300_houston_tx_77002_5217,
        loc:c_o_enbridge_inc_3000_425_1st_calgary_alberta_canada .

