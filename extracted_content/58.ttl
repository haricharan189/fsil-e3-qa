@prefix base: <http://example.org/base/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:kmg_capital_partners a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:investor .

org1:lathamand_watkins_llp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:counsel .

org1:llc_and_kkr_biosimilar_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:investor .

org1:mx_ii_associates_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:investor .

org_role:agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:counsel rdfs:subClassOf base:Organization .

person:michael_fleming a base:Person ;
    <http://example.org/isInstanceOf/> position:president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:intekrin_therapeutics_inc ;
            rel:position position:president ] ;
    rel:isEmployedBy org1:intekrin_therapeutics_inc .

org1:hcr_collateral_management_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent ;
    rel:hasEmployee person:clarke_b_futch .

org1:hcr_molag_fund_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lenders ;
    rel:hasEmployee person:clarke_b_futch .

org1:hcrp_overflow_fund_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lenders ;
    rel:hasEmployee person:clarke_b_futch .

org1:healthcare_royalty_partners_iii_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:investor,
        org_role:lenders ;
    rel:hasEmployee person:clarke_b_futch .

org1:intekrin_therapeutics_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:michael_fleming .

org_role:guarantors rdfs:subClassOf base:Organization .

person:dennis_m_lanfear a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_executive_officer,
        position:president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:coherus_biosciences_inc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:coherus_biosciences_inc ;
            rel:position position:chief_executive_officer ],
        [ a rel:Employment ;
            rel:organization org1:coherus_intermediate_corp ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:coherus_intermediate_corp ;
            rel:position position:chief_executive_officer ] ;
    rel:isEmployedBy org1:coherus_biosciences_inc,
        org1:coherus_intermediate_corp .

org1:coherus_biosciences_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:dennis_m_lanfear .

org1:coherus_intermediate_corp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:dennis_m_lanfear .

org_role:lenders rdfs:subClassOf base:Organization .

position:chief_executive_officer a base:Position ;
    base:positionName "Chief Executive Officer" ;
    rdfs:subClassOf base:Person .

org_role:investor rdfs:subClassOf base:Organization .

person:clarke_b_futch a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_partner ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:healthcare_royalty_partners_iii_lp ;
            rel:position position:managing_partner ],
        [ a rel:Employment ;
            rel:organization org1:hcr_molag_fund_lp ;
            rel:position position:managing_partner ],
        [ a rel:Employment ;
            rel:organization org1:hcrp_overflow_fund_lp ;
            rel:position position:managing_partner ],
        [ a rel:Employment ;
            rel:organization org1:hcr_collateral_management_llc ;
            rel:position position:managing_partner ] ;
    rel:isEmployedBy org1:hcr_collateral_management_llc,
        org1:hcr_molag_fund_lp,
        org1:hcrp_overflow_fund_lp,
        org1:healthcare_royalty_partners_iii_lp .

position:managing_partner a base:Position ;
    base:positionName "Managing Partner" ;
    rdfs:subClassOf base:Person .

position:president a base:Position ;
    base:positionName "President" ;
    rdfs:subClassOf base:Person .

