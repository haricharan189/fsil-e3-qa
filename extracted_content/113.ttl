position:secretary_treasurer a base:Position ;
    base:positionName "Secretary/Treasurer" ;
    rdfs:subClassOf base:Person .

person:sonja_k_mcclelland a base:Person ;
    <http://example.org/isInstanceOf/> position:manager,
        position:managing_director_a_and_authorized_representative,
        position:secretary_treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:machinery_sales_co_llc ;
            rel:position position:manager ],
