person:peter_kim a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_executive_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:hudson_clothing_llc ;
            rel:position position:chief_executive_officer ],
        [ a rel:Employment ;
            rel:organization org1:hudson_clothing_holdingsinc ;
            rel:position position:chief_executive_officer ],
        [ a rel:Employment ;
            rel:organization org1:hc_acquisition_holdingsinc ;
            rel:position position:chief_executive_officer ] ;
    rel:isEmployedBy org1:hc_acquisition_holdingsinc,
        org1:hudson_clothing_holdingsinc,
        org1:hudson_clothing_llc .

person:hamish_sandhu a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:innovo_west_salesinc ;
            rel:position position:chief_financial_officer ],
