            rel:organization org1:differential_brands_group_inc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:dbg_holdings_subsidiary_inc,
        org1:dbg_subsidiary_inc,
        org1:differential_brands_group_inc,
        org1:innovo_west_salesinc .

person:suzanne_grosso a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:tcw_asset_management_company ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:west_virginia_direct_lending_llc ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:tcw_direct_lending_llc ;
