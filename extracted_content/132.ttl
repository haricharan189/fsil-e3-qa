location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:bmo_capital_markets_corp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:book_runners .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:joint_book_runners .

loc:115_south_lasalle_street_chicago_illinois_60603 a base:Location ;
    rel:isLocationOf org1:bank_of_montreal .

loc:1655_grant_street_10th_floor_concord_ca_94520 a base:Location ;
    rel:isLocationOf org1:assetmark_financial_holdings_inc .

org_role:agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:l_c_issuer rdfs:subClassOf base:Organization .

person:amy_prager a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_montreal ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:bank_of_montreal .

