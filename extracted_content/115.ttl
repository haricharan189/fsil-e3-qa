@prefix base: <http://example.org/base/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:splash_holdings_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:adam_rose a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:adam_rose .

position:assistant_secretary a base:Position ;
    base:positionName "Assistant Secretary" ;
    rdfs:subClassOf base:Person .

position:chief_accounting_officer a base:Position ;
    base:positionName "Chief Accounting Officer" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

org1:alliance_trading_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:melanie_housey_hart .

org1:cypress_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:melanie_housey_hart .

org1:poolfx_supply_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:melanie_housey_hart .

org1:scp_international_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:melanie_housey_hart .

position:president a base:Position ;
    base:positionName "President" ;
    rdfs:subClassOf base:Person .

org1:horizon_distributors_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:jennifer_m_neil .

org1:pool_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:jennifer_m_neil .

org1:pool_development_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:jennifer_m_neil .

org1:scp_distributors_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:jennifer_m_neil .

org1:superior_pool_products_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:jennifer_m_neil .

person:melanie_housey_hart a base:Person ;
    <http://example.org/isInstanceOf/> position:assistant_secretary,
        position:chief_accounting_officer,
        position:president,
        position:secretary,
        position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:poolfx_supply_llc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:alliance_trading_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:cypress_inc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:scp_international_inc ;
            rel:position position:assistant_secretary ],
        [ a rel:Employment ;
            rel:organization org1:poolfx_supply_llc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:scp_international_inc ;
            rel:position position:chief_accounting_officer ],
        [ a rel:Employment ;
            rel:organization org1:alliance_trading_inc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:cypress_inc ;
            rel:position position:secretary ] ;
    rel:isEmployedBy org1:alliance_trading_inc,
        org1:cypress_inc,
        org1:poolfx_supply_llc,
        org1:scp_international_inc .

person:jennifer_m_neil a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_legal_officer,
        position:secretary,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:superior_pool_products_llc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:scp_distributors_llc ;
            rel:position position:chief_legal_officer ],
        [ a rel:Employment ;
            rel:organization org1:pool_corporation ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:pool_corporation ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:horizon_distributors_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:superior_pool_products_llc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:horizon_distributors_inc ;
            rel:position position:chief_legal_officer ],
        [ a rel:Employment ;
            rel:organization org1:superior_pool_products_llc ;
            rel:position position:chief_legal_officer ],
        [ a rel:Employment ;
            rel:organization org1:scp_distributors_llc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:pool_development_llc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:horizon_distributors_inc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:pool_corporation ;
            rel:position position:chief_legal_officer ],
        [ a rel:Employment ;
            rel:organization org1:pool_development_llc ;
            rel:position position:chief_legal_officer ],
        [ a rel:Employment ;
            rel:organization org1:pool_development_llc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:scp_distributors_llc ;
            rel:position position:secretary ] ;
    rel:isEmployedBy org1:horizon_distributors_inc,
        org1:pool_corporation,
        org1:pool_development_llc,
        org1:scp_distributors_llc,
        org1:superior_pool_products_llc .

position:chief_legal_officer a base:Position ;
    base:positionName "Chief Legal Officer" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org_role:guarantors rdfs:subClassOf base:Organization .

position:secretary a base:Position ;
    base:positionName "Secretary" ;
    rdfs:subClassOf base:Person .

