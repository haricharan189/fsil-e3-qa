location_type:micro_building_and_corporate_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:middle_market_servicing a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:offsite_storage a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:opto_building a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

