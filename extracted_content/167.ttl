org1:bank_of_america_merrill_lynch a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:sole_book_manager,
        org_role:sole_lead_arranger .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:l_c_issuer rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

org_role:sole_book_manager rdfs:subClassOf base:Organization .

org_role:sole_lead_arranger rdfs:subClassOf base:Organization .

org_role:swingline_lender rdfs:subClassOf base:Organization .

person:shelley_a_mcgregor a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:l_c_issuer,
        org_role:lender,
        org_role:swingline_lender ;
    rel:hasEmployee person:shelley_a_mcgregor .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

org_role:guarantors rdfs:subClassOf base:Organization .

org1:powell_electrical_systems_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:don_r_madison .

org1:powell_industries_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:don_r_madison .

org1:powell_industries_international_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:don_r_madison .

org1:transdyn_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:don_r_madison .

person:don_r_madison a base:Person ;
    <http://example.org/isInstanceOf/> position:secretary,
        position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:transdyn_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:powell_electrical_systems_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:powell_industries_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:powell_industries_international_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:transdyn_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:powell_electrical_systems_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:powell_industries_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:powell_industries_international_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:powell_industries_international_inc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:powell_electrical_systems_inc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:transdyn_inc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:powell_industries_inc ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:powell_electrical_systems_inc,
        org1:powell_industries_inc,
        org1:powell_industries_international_inc,
        org1:transdyn_inc .

position:secretary a base:Position ;
    base:positionName "Secretary" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

