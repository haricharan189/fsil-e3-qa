        org_role:pledgor ;
    rel:hasLocationAt loc:1310_point_street_12th_floor_baltimore_md_21231 .

org1:morgan_stanley_senior_funding_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bookrunner,
