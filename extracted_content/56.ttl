@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:access_industries_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:sponsor .

org1:morgan_stanley_senior_funding_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents .

org1:ubs_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:syndication_agents .

org_role:agent rdfs:subClassOf base:Organization .

person:pierre_maugüé a base:Person .

loc:1633_broadway_7th_floor_new_york_ny_10019 a base:Location ;
    rel:isLocationOf org1:wmg_acquisition_corp .

loc:919_third_avenue_new_york_new_york_10022 a base:Location ;
    rel:isLocationOf org1:debevoise_and_plimpton_llp .

loc:eleven_madison_avenue_new_york_ny_10010 a base:Location ;
    rel:isLocationOf org1:credit_suisse_ag .

org1:credit_suisse_ag a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:collateral_agent ;
    rel:hasLocationAt loc:eleven_madison_avenue_new_york_ny_10010 .

org1:debevoise_and_plimpton_llp a base:Organization ;
    rel:hasLocationAt loc:919_third_avenue_new_york_new_york_10022 .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:sponsor rdfs:subClassOf base:Organization .

person:chris_walton a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:barclays_bank_plc ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:barclays_bank_plc .

person:d_andrew_maletta a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:credit_suisse_ag_cayman_islands_branch ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:credit_suisse_ag_cayman_islands_branch .

person:darlene_arias a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:ubs_ag_stamford_branch ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:ubs_ag_stamford_branch .

person:judith_smith a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:credit_suisse_ag_cayman_islands_branch ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:credit_suisse_ag_cayman_islands_branch .

person:kenneth_chin a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:ubs_ag_stamford_branch ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:ubs_ag_stamford_branch .

person:lee_a_olive a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:nomura_corporate_funding_americas_llc ;
            rel:position position:managing_director ] ;
    rel:isEmployedBy org1:nomura_corporate_funding_americas_llc .

person:melissa_james a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:morgan_stanley_bank_na ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:morgan_stanley_bank_na .

person:paul_m_robinson a base:Person ;
    <http://example.org/isInstanceOf/> position:executive_vice_president_general_counsel,
        position:secretary ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wmg_acquisition_corp ;
            rel:position position:executive_vice_president_general_counsel ],
        [ a rel:Employment ;
            rel:organization org1:wmg_acquisition_corp ;
            rel:position position:secretary ] ;
    rel:isEmployedBy org1:wmg_acquisition_corp .

person:rebecca_kratz a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:goldman_sachs_bank_usa ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:goldman_sachs_bank_usa .

org1:barclays_bank_plc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:chris_walton .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:rebecca_kratz .

org1:morgan_stanley_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:melissa_james .

org1:nomura_corporate_funding_americas_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:lee_a_olive .

position:executive_vice_president_general_counsel a base:Position ;
    base:positionName "Executive Vice President, General Counsel" ;
    rdfs:subClassOf base:Person .

position:managing_director a base:Position ;
    base:positionName "Managing Director" ;
    rdfs:subClassOf base:Person .

position:secretary a base:Position ;
    base:positionName "Secretary" ;
    rdfs:subClassOf base:Person .

org_role:agents rdfs:subClassOf base:Organization .

org1:credit_suisse_ag_cayman_islands_branch a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender ;
    rel:hasEmployee person:d_andrew_maletta,
        person:judith_smith .

org1:ubs_ag_stamford_branch a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:darlene_arias,
        person:kenneth_chin .

org1:wmg_acquisition_corp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:paul_m_robinson ;
    rel:hasLocationAt loc:1633_broadway_7th_floor_new_york_ny_10019 .

org_role:lender rdfs:subClassOf base:Organization .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

