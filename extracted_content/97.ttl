    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

loc:500_west_monroe_street_chicago_illinois60661 a base:Location .

loc:5804_trailridge_drive_austin_texas78731 a base:Location .

org1:hp_redding_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower .

org1:summit_portland_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower .

org1:summit_salem_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower .

org_role:agent rdfs:subClassOf base:Organization .

loc:2_south_pointe_drive_suite_1400_lake_forest_california_92630 a base:Location ;
    rel:isLocationOf org1:summit_healthcare_reit_inc .

loc:500_west_monroe_street_chicago_illinois_60661 a base:Location ;
    rel:isLocationOf org1:general_electric_capital_corporation .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:dague_retzlaff a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:general_electric_capital_corporation ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:general_electric_capital_corporation ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:general_electric_capital_corporation .

person:diana_pennington a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_counsel_hfs_real_estate ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:general_electric_capital_corporation ;
            rel:position position:chief_counsel_hfs_real_estate ] ;
    rel:isEmployedBy org1:general_electric_capital_corporation .

person:jeffrey_m_muchmore a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:general_electric_capital_corporation ;
            rel:position position:managing_director ] ;
    rel:isEmployedBy org1:general_electric_capital_corporation .

person:kent_eikanas a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_operating_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:summit_healthcare_reit_inc ;
            rel:position position:chief_operating_officer ] ;
    rel:isEmployedBy org1:summit_healthcare_reit_inc .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:chief_counsel_hfs_real_estate a base:Position ;
    base:positionName "Chief Counsel-\\n 	 	HFS Real Estate" ;
    rdfs:subClassOf base:Person .

position:chief_operating_officer a base:Position ;
    base:positionName "Chief Operating Officer" ;
    rdfs:subClassOf base:Person .

position:managing_director a base:Position ;
    base:positionName "Managing Director" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:summit_healthcare_reit_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:kent_eikanas ;
    rel:hasLocationAt loc:2_south_pointe_drive_suite_1400_lake_forest_california_92630 .

org_role:borrower rdfs:subClassOf base:Organization .

org1:general_electric_capital_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender ;
    rel:hasEmployee person:dague_retzlaff,
        person:diana_pennington,
        person:jeffrey_m_muchmore ;
    rel:hasLocationAt loc:500_west_monroe_street_chicago_illinois_60661 .

