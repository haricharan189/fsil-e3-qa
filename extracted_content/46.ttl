@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:mvc_cayman a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors .

org1:mvc_financial_servicesinc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors .

org1:mvc_partners_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors .

loc:111_south_wacker_drive_chicagoillinois_60606 a base:Location ;
    rel:isLocationOf org1:locke_lord_llp .

loc:230_park_avenue_new_york_new_york_10169 a base:Location ;
    rel:isLocationOf org1:otterbourg_pc .

loc:287_bowman_ave_241_purchase_ny_10577 a base:Location ;
    rel:isLocationOf org1:mvc_capitalinc .

loc:55_east_monroe_suite3300_chicagoil_60603 a base:Location ;
    rel:isLocationOf org1:goldberg_kohn_ltd .

loc:830_morris_turnpike_3rdfloor_short_hills_nj_07078 a base:Location ;
    rel:isLocationOf org1:santander_bank_na .

loc:at_wintrust_bank_231_s_lasalle_street_2ndfloor_chicagoil_60604 a base:Location ;
    rel:isLocationOf org1:wintrust_bank .

org1:goldberg_kohn_ltd a base:Organization ;
    rel:hasLocationAt loc:55_east_monroe_suite3300_chicagoil_60603 .

org1:locke_lord_llp a base:Organization ;
    rel:hasLocationAt loc:111_south_wacker_drive_chicagoillinois_60606 .

org1:mvc_capitalinc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasLocationAt loc:287_bowman_ave_241_purchase_ny_10577 .

org1:otterbourg_pc a base:Organization ;
    rel:hasLocationAt loc:230_park_avenue_new_york_new_york_10169 .

org_role:agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:gregory_r_russano a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:santander_bank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:santander_bank_na .

person:james_pinto a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_executive_officer,
        position:manager ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:mvc_gp_ii_llc ;
            rel:position position:manager ],
        [ a rel:Employment ;
            rel:organization org1:mvc_gp_ii_llc ;
            rel:position position:chief_executive_officer ] ;
    rel:isEmployedBy org1:mvc_gp_ii_llc .

person:john_paul_hills a base:Person ;
    <http://example.org/isInstanceOf/> position:vp ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wintrust_bank ;
            rel:position position:vp ] ;
    rel:isEmployedBy org1:wintrust_bank .

position:chief_executive_officer a base:Position ;
    base:positionName "Chief Executive Officer" ;
    rdfs:subClassOf base:Person .

position:manager a base:Position ;
    base:positionName "Manager" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:vp a base:Position ;
    base:positionName "VP" ;
    rdfs:subClassOf base:Person .

org1:mvc_gp_ii_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasEmployee person:james_pinto .

org1:santander_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasEmployee person:gregory_r_russano ;
    rel:hasLocationAt loc:830_morris_turnpike_3rdfloor_short_hills_nj_07078 .

org1:wintrust_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:counsel_lender ;
    rel:hasEmployee person:john_paul_hills ;
    rel:hasLocationAt loc:at_wintrust_bank_231_s_lasalle_street_2ndfloor_chicagoil_60604 .

org_role:guarantors rdfs:subClassOf base:Organization .

