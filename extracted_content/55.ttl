@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

loc:ex a base:Location .

org1:simpson_thacher_and_bartlett_llp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:special_counsel_for_the_borrower .

org_role:agent rdfs:subClassOf base:Organization .

person:kristopher_m_hansen a base:Person .

person:marisa_d_stavenas a base:Person .

person:william_b_sheehan a base:Person .

position:financial_officer rdfs:subClassOf base:Person .

loc:110_west_front_street_po_box_500_red_bank_new_jersey_07701 a base:Location ;
    rel:isLocationOf org1:hovnanian_enterprises_inc .

loc:180_maiden_lane_new_york_ny_10038 a base:Location ;
    rel:isLocationOf org1:stroock_and_stroock_and_lavan_llp .

loc:345_park_ave_new_york_ny_10154 a base:Location ;
    rel:isLocationOf org1:gso_capital_partners_lp .

loc:50_south_sixth_street_suite_1290_minneapolis_mn_55402 a base:Location ;
    rel:isLocationOf org1:wilmington_trust_national_association .

org1:gso_capital_partners_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:purchaser ;
    rel:hasLocationAt loc:345_park_ave_new_york_ny_10154 .

org1:stroock_and_stroock_and_lavan_llp a base:Organization ;
    rel:hasLocationAt loc:180_maiden_lane_new_york_ny_10038 .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:holdings rdfs:subClassOf base:Organization .

org_role:purchaser rdfs:subClassOf base:Organization .

org_role:special_counsel_for_the_borrower rdfs:subClassOf base:Organization .

person:cora_holland_koller a base:Person ;
    <http://example.org/isInstanceOf/> position:banking_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wilmington_trust_national_association ;
            rel:position position:banking_officer ] ;
    rel:isEmployedBy org1:wilmington_trust_national_association .

org1:k_hovnanian_enterprises_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:j_larry_sorsby .

person:j_larry_sorsby a base:Person ;
    <http://example.org/isInstanceOf/> position:chief,
        position:executive_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:hovnanian_enterprises_inc ;
            rel:position position:chief ],
        [ a rel:Employment ;
            rel:organization org1:hovnanian_enterprises_inc ;
            rel:position position:executive_vice_president ],
        [ a rel:Employment ;
            rel:organization org1:k_hovnanian_enterprises_inc ;
            rel:position position:chief ] ;
    rel:isEmployedBy org1:hovnanian_enterprises_inc,
        org1:k_hovnanian_enterprises_inc .

position:banking_officer a base:Position ;
    base:positionName "Banking Officer" ;
    rdfs:subClassOf base:Person .

position:executive_vice_president a base:Position ;
    base:positionName "Executive Vice President" ;
    rdfs:subClassOf base:Person .

org1:wilmington_trust_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent ;
    rel:hasEmployee person:cora_holland_koller ;
    rel:hasLocationAt loc:50_south_sixth_street_suite_1290_minneapolis_mn_55402 .

position:chief a base:Position ;
    base:positionName "Chief" ;
    rdfs:subClassOf base:Person .

org1:hovnanian_enterprises_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:holdings ;
    rel:hasEmployee person:j_larry_sorsby ;
    rel:hasLocationAt loc:110_west_front_street_po_box_500_red_bank_new_jersey_07701 .

