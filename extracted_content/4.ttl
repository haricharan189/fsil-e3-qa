    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:brighthorizonsfamilysolutionsllc ;
            rel:position position:chief_executive_officer ],
        [ a rel:Employment ;
            rel:organization org1:bright_horizons_capital_corp ;
            rel:position position:chief_executive_officer ] ;
    rel:isEmployedBy org1:bright_horizons_capital_corp,
        org1:brighthorizonsfamilysolutionsllc .

