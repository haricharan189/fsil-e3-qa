@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org_role:agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:runner rdfs:subClassOf base:Organization .

loc:1048_industrial_court_suite_e_suwanee_ga_30024 a base:Location ;
    rel:isLocationOf org1:digirad_corporation .

loc:2450_colorado_avenue_suite_3000_west_santa_monica_ca_90404 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

loc:65_east_55th_street_new_york_ny_10022 a base:Location ;
    rel:isLocationOf org1:olshan_frome_wolosky_llp .

loc:695_town_center_drive_17th_floor_costa_mesa_ca_92626 a base:Location ;
    rel:isLocationOf org1:paul_hastings_llp .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:book_runner rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:adam_finerman a base:Person ;
    <http://example.org/isInstanceOf/> position:esq ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:olshan_frome_wolosky_llp ;
            rel:position position:esq ] ;
    rel:isEmployedBy org1:olshan_frome_wolosky_llp .

person:katherine_bell a base:Person ;
    <http://example.org/isInstanceOf/> position:esq ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:paul_hastings_llp ;
            rel:position position:esq ] ;
    rel:isEmployedBy org1:paul_hastings_llp .

person:kathy_r_plisko a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_bank_national_association ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:wells_fargo_bank_national_association .

org1:digirad_imaging_solutions_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:jeffry_r_keyes .

org1:dms_health_technologies_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:jeffry_r_keyes .

org1:dms_imaging_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:jeffry_r_keyes .

org1:project_rendezvous_holding_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:jeffry_r_keyes .

org1:telerhythmics_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:jeffry_r_keyes .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:president a base:Position ;
    base:positionName "President" ;
    rdfs:subClassOf base:Person .

org1:digirad_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_borrower,
        org_role:borrowers ;
    rel:hasEmployee person:jeffry_r_keyes ;
    rel:hasLocationAt loc:1048_industrial_court_suite_e_suwanee_ga_30024 .

org1:md_office_solutions a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:jeffry_r_keyes .

org1:olshan_frome_wolosky_llp a base:Organization ;
    rel:hasEmployee person:adam_finerman ;
    rel:hasLocationAt loc:65_east_55th_street_new_york_ny_10022 .

org1:paul_hastings_llp a base:Organization ;
    rel:hasEmployee person:katherine_bell ;
    rel:hasLocationAt loc:695_town_center_drive_17th_floor_costa_mesa_ca_92626 .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:arranger,
        org_role:book_runner,
        org_role:lender,
        org_role:sole_book_runner ;
    rel:hasEmployee person:kathy_r_plisko ;
    rel:hasLocationAt loc:2450_colorado_avenue_suite_3000_west_santa_monica_ca_90404 .

position:esq a base:Position ;
    base:positionName "Esq." ;
    rdfs:subClassOf base:Person .

org_role:borrowers rdfs:subClassOf base:Organization .

person:jeffry_r_keyes a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer,
        position:president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:md_office_solutions ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:digirad_imaging_solutions_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:dms_health_technologies_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:md_office_solutions ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:digirad_corporation ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:dms_imaging_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:project_rendezvous_holding_corporation ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:telerhythmics_llc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:digirad_corporation,
        org1:digirad_imaging_solutions_inc,
        org1:dms_health_technologies_inc,
        org1:dms_imaging_inc,
        org1:md_office_solutions,
        org1:project_rendezvous_holding_corporation,
        org1:telerhythmics_llc .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

