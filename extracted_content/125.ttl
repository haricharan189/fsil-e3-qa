org_role:agent rdfs:subClassOf base:Organization .

person:joe_horrigan a base:Person .

loc:1420_5th_avenue_9th_floor_seattle_wa_98101 a base:Location ;
    rel:isLocationOf org1:us_bank_agency_services .

loc:414_silver_ave_sw_ms0905_albuquerque_new_mexico_87102_3289 a base:Location ;
    rel:isLocationOf org1:public_service_company_of_new_mexico .

loc:new_mexico a base:Location ;
    rel:isLocationOf org1:public_service_company_of_new_mexico .

loc:us_bank_utilities_division_461_fifth_avenue_8th_floor_new_york_ny_10017 a base:Location ;
    rel:isLocationOf org1:us_bank_national_association .

org1:us_bank_agency_services a base:Organization ;
    rel:hasLocationAt loc:1420_5th_avenue_9th_floor_seattle_wa_98101 .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:book_manager rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

person:david_r_barney a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:eric_j_cosgrove a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:us_bank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:us_bank_national_association .

person:joseph_d_tarry a base:Person ;
    <http://example.org/isInstanceOf/> position:controller,
        position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:public_service_company_of_new_mexico ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:public_service_company_of_new_mexico ;
            rel:position position:controller ],
        [ a rel:Employment ;
            rel:organization org1:public_service_company_of_new_mexico ;
            rel:position position:treasurer ] ;
    rel:isEmployedBy org1:public_service_company_of_new_mexico .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:david_r_barney .

org_role:lender rdfs:subClassOf base:Organization .

position:controller a base:Position ;
    base:positionName "Controller" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:us_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:arranger,
        org_role:book_manager,
        org_role:lender ;
    rel:hasEmployee person:eric_j_cosgrove ;
    rel:hasLocationAt loc:us_bank_utilities_division_461_fifth_avenue_8th_floor_new_york_ny_10017 .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

org1:public_service_company_of_new_mexico a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:joseph_d_tarry ;
    rel:hasLocationAt loc:414_silver_ave_sw_ms0905_albuquerque_new_mexico_87102_3289,
        loc:new_mexico .

