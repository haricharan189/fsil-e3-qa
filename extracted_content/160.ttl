org1:bofa_securities_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_bookrunners,
        org_role:joint_lead_arrangers .

org1:morgan_stanley_senior_funding_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_bookrunners,
        org_role:joint_lead_arrangers .

position:managing_director rdfs:subClassOf base:Person .

loc:32_old_slip_new_york_new_york_10005 a base:Location ;
    rel:isLocationOf org1:cahill_gordonand_reindel_llp .

org1:cahill_gordonand_reindel_llp a base:Organization ;
    rel:hasLocationAt loc:32_old_slip_new_york_new_york_10005 .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

person:amanuel_assefa a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:bank_of_america_na .

