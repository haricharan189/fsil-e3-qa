    rdfs:subClassOf base:Person .

org_role:joint_bookrunners rdfs:subClassOf base:Organization .

org_role:joint_lead_arrangers rdfs:subClassOf base:Organization .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org_role:issuing_bank rdfs:subClassOf base:Organization .

