@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:acadia_1520_milwaukee_avenue_llc a base:Organization .

org1:acadia_28_jericho_turnpike_llc a base:Organization .

org1:acadia_2914_third_avenue_llc a base:Organization .

org1:acadia_5_7_east_17th_street_llc a base:Organization .

org1:acadia_83_spring_street_llc a base:Organization .

org1:acadia_bartow_avenue_llc a base:Organization .

org1:acadia_chestnut_llc a base:Organization .

org1:acadia_gold_coast_llc a base:Organization .

org1:acadia_mad_river_property_llc a base:Organization .

org1:acadia_mercer_street_llc a base:Organization .

org1:acadia_rush_walton_llc a base:Organization .

org1:acadia_town_line_llc a base:Organization .

org1:acadia_west_54th_street_llc a base:Organization .

org1:mark_plaza_fifty_lp a base:Organization .

org1:merrill_lynch_pierce_fenner_and_smith_incorporated a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_lead_arranger,
        org_role:sole_bookrunner .

org1:wells_fargo_securities a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_lead_arrangers .

org_role:bookrunner rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:guarantors rdfs:subClassOf base:Organization .

org_role:lead_arranger rdfs:subClassOf base:Organization .

loc:delaware a base:Location ;
    rel:isLocationOf org1:acadia_realty_limited_partnership .

loc:maryland a base:Location ;
    rel:isLocationOf org1:acadia_realty_trust .

org1:acadia_realty_limited_partnership a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:subsidiaries_guarantors ;
    rel:hasLocationAt loc:delaware .

org1:acadia_realty_trust a base:Organization ;
    rel:hasLocationAt loc:maryland .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:l_c_issuer rdfs:subClassOf base:Organization .

org_role:lead_arrangers rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

org_role:swing_line_lender rdfs:subClassOf base:Organization .

person:andrew_w_hussion a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_bank ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:wells_fargo_bank .

person:denise_smyth a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:pnc_bank ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:pnc_bank .

person:robert_masters a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:acadia_west_shore_expressway_llc ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:acadia_west_shore_expressway_llc .

person:roy_e_alexander a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:senior_vice_president ],
        [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

org1:acadia_west_shore_expressway_llc a base:Organization ;
    rel:hasEmployee person:robert_masters .

org1:pnc_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agents,
        org_role:lead_arrangers ;
    rel:hasEmployee person:denise_smyth .

org1:wells_fargo_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agents ;
    rel:hasEmployee person:andrew_w_hussion .

org_role:documentation_agents rdfs:subClassOf base:Organization .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:l_c_issuer,
        org_role:lender,
        org_role:swing_line_lender ;
    rel:hasEmployee person:roy_e_alexander .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

