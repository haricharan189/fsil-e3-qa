    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:maureen_s_malphus .

position:executive_director a base:Position ;
    base:positionName "Executive Director" ;
    rdfs:subClassOf base:Person .

position:manager_agency a base:Position ;
    base:positionName "Manager, Agency" ;
    rdfs:subClassOf base:Person .

position:managing_director a base:Position ;
    base:positionName "Managing Director" ;
    rdfs:subClassOf base:Person .

position:president a base:Position ;
    base:positionName "President" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:caseys_general_stores_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:terry_w_handley ;
    rel:hasLocationAt loc:one_convenience_blvd_ankeny_ia_50021 .

org1:coöperatieve_rabobank_ua_new_york a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:robert_graff,
        person:timothy_j_devane .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

org1:royal_bank_of_canada a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:issuing_bank,
        org_role:lender ;
    rel:hasEmployee person:john_flores,
        person:rodica_dutka ;
    rel:hasLocationAt loc:200_vesey_street_new_york_new_york_10281,
        loc:rbc_agency_services_group_20_king_street_west_4th_floor_toronto_ontario_canada .

org_role:lender rdfs:subClassOf base:Organization .

