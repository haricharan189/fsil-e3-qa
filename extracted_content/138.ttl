    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender ;
    rel:hasEmployee person:nicolas_zitelli ;
    rel:hasLocationAt loc:575_market_street_floor_28_san_francisco_ca_94105,
        loc:pnc_firstside_center_500_first_avenue_fourth_floor_pittsburgh_pa_15219 .

org1:rexford_industrial_realty_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:adeel_khan ;
    rel:hasLocationAt loc:11620_wilshire_boulevard_suite_1000_los_angeles_california_90025 .

position:senior_vice_president a base:Position ;
