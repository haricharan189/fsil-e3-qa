org1:pnc_capital_markets_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_lead_arrangers .

position:chief_financial_officer_and_secretary rdfs:subClassOf base:Person .

loc:575_market_street_floor_28_san_francisco_ca_94105 a base:Location ;
    <http://example.org/isInstanceOf/> location_type:administrative_agents_office,
        location_type:business_matters ;
    rel:isLocationOf org1:pnc_bank_national_association .

loc:pnc_firstside_center_500_first_avenue_fourth_floor_pittsburgh_pa_15219 a base:Location ;
    <http://example.org/isInstanceOf/> location_type:administrative_agents_office,
