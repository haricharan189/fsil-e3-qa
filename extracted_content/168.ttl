@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:administrative_agents_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:administrative_matters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ag_new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_services a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:assembly_building a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:business_matters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:commercial_banking a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_customers_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:domestic_lending_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dublin_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:eurodollar_lending_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:front_end_test_building a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:london_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:mexico_location_contract_manufacturing a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:micro_building_and_corporate_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:middle_market_servicing a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:offsite_storage a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:opto_building a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:rexford_industrial_realty_inc_11620_wilshire_boulevard_suite_1000_los_angeles_california_90025 a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:zonal_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:bank_of_america a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:syndication_agent .

org1:bofa_securities_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:book_runners,
        org_role:lead_arrangers .

loc:1000_stanley_drive_new_britain_connecticut_06053 a base:Location ;
    rel:isLocationOf org1:stanley_blackand_decker_inc .

loc:building_ops_ii_one_penns_way_new_castle_de_19720 a base:Location ;
    rel:isLocationOf org1:citibank_na .

loc:building_ops_ii_one_penns_way_new_castle_de_19720_attn_bank_loan_syndications a base:Location ;
    rel:isLocationOf org1:citibank .

org1:citibank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:book_runners,
        org_role:lead_arrangers ;
    rel:hasLocationAt loc:building_ops_ii_one_penns_way_new_castle_de_19720_attn_bank_loan_syndications .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

person:carolyn_a_kee a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citibank_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:citibank_na .

person:michael_contreras a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:robert_t_paternostro a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:stanley_blackand_decker_inc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:stanley_blackand_decker_inc ;
            rel:position position:treasurer ] ;
    rel:isEmployedBy org1:stanley_blackand_decker_inc .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender,
        org_role:lenders,
        org_role:syndication_agent ;
    rel:hasEmployee person:michael_contreras .

org_role:book_runners rdfs:subClassOf base:Organization .

org_role:lead_arrangers rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

org_role:lenders rdfs:subClassOf base:Organization .

org_role:syndication_agent rdfs:subClassOf base:Organization .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

org1:citibank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender,
        org_role:lenders ;
    rel:hasEmployee person:carolyn_a_kee ;
    rel:hasLocationAt loc:building_ops_ii_one_penns_way_new_castle_de_19720 .

org1:stanley_blackand_decker_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:robert_t_paternostro ;
    rel:hasLocationAt loc:1000_stanley_drive_new_britain_connecticut_06053 .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

