    rel:hasLocationAt loc:6300_south_syracuse_way_suite_300_centennial_co_80111 .

org1:wilmington_savings_fund_society_fsb a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:collateral_agent ;
    rel:hasEmployee person:raye_goldsborough ;
    rel:hasLocationAt loc:500_delaware_avenue_11th_floor_wilmington_de_19081 .

