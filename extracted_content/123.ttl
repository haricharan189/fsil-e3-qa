@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:citigroup_global_markets_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bookrunners .

org1:jp_morgan_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:bookrunners .

org1:rbc_capital_markets a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:joint_bookrunners,
        org_role:syndication_agent .

loc:cayman_islands a base:Location ;
    <http://example.org/isInstanceOf/> location_type:branch ;
    rel:isLocationOf org1:credit_suisse_ag .

loc:dublin a base:Location ;
    <http://example.org/isInstanceOf/> location_type:branch ;
    rel:isLocationOf org1:ing_bank_nv .

org_role:borrower rdfs:subClassOf base:Organization .

person:andrew_payne a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_bank ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:wells_fargo_bank .

person:bill_odaly a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:credit_suisse_ag ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:credit_suisse_ag .

person:brandon_k_fiddler a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:pnc_bank ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:pnc_bank .

person:gene_r_riego_de_dios a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank_na .

person:john_b_ellis a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:newell_rubbermaid_inc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:newell_rubbermaid_inc ;
            rel:position position:treasurer ] ;
    rel:isEmployedBy org1:newell_rubbermaid_inc .

person:julia_ivanova a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:royal_bank_of_canada ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:royal_bank_of_canada .

person:kelly_heimrich a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:credit_suisse_ag ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:credit_suisse_ag .

person:kimberly_a_crotty a base:Person ;
    <http://example.org/isInstanceOf/> position:vp ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:the_northern_trust_company ;
            rel:position position:vp ] ;
    rel:isEmployedBy org1:the_northern_trust_company .

person:kyle_lewis a base:Person ;
    <http://example.org/isInstanceOf/> position:avp ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:avp ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:lisa_huang a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citibank_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:citibank_na .

person:ravneet_mumick a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:the_bank_of_tokyo_mitsubishi_ufj_ltd ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:the_bank_of_tokyo_mitsubishi_ufj_ltd .

person:robert_ehudin a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:goldman_sachs_bank_usa ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:goldman_sachs_bank_usa .

person:sean_hassett a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:ing_bank_nv ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:ing_bank_nv .

person:shaun_hawley a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:ing_bank_nv ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:ing_bank_nv .

person:steven_l_sawyer a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:us_bank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:us_bank_national_association .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasEmployee person:kyle_lewis .

org1:citibank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasEmployee person:lisa_huang .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:arranger,
        org_role:bookrunners,
        org_role:lender ;
    rel:hasEmployee person:robert_ehudin .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender ;
    rel:hasEmployee person:gene_r_riego_de_dios .

org1:pnc_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agent,
        org_role:lender ;
    rel:hasEmployee person:brandon_k_fiddler .

org1:royal_bank_of_canada a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:julia_ivanova .

org1:the_bank_of_tokyo_mitsubishi_ufj_ltd a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasEmployee person:ravneet_mumick .

org1:the_northern_trust_company a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:kimberly_a_crotty .

org1:us_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:steven_l_sawyer .

org1:wells_fargo_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasEmployee person:andrew_payne .

position:avp a base:Position ;
    base:positionName "AVP" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

position:vp a base:Position ;
    base:positionName "VP" ;
    rdfs:subClassOf base:Person .

org1:newell_rubbermaid_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:john_b_ellis .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:bookrunners rdfs:subClassOf base:Organization .

org1:credit_suisse_ag a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasEmployee person:bill_odaly,
        person:kelly_heimrich ;
    rel:hasLocationAt loc:cayman_islands .

org1:ing_bank_nv a base:Organization ;
    rel:hasEmployee person:sean_hassett,
        person:shaun_hawley ;
    rel:hasLocationAt loc:dublin .

org_role:agent rdfs:subClassOf base:Organization .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

