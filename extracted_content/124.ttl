@prefix base: <http://example.org/base/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:branch_banking a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agents .

org1:keybanc_capital_markets_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lead_arrangers .

org1:merrill_lynch_pierce_fennerand_smith_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bookrunners .

org1:trust_company a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agents .

org1:wells_fargo_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agents .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

person:catherine_damico a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer,
        position:executive_vice_president_of_finance,
        position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:monro_muffler_brake_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:monro_muffler_brake_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:monro_muffler_brake_inc ;
            rel:position position:executive_vice_president_of_finance ] ;
    rel:isEmployedBy org1:monro_muffler_brake_inc .

person:christine_keating a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citibank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:citibank_na .

person:craig_welch a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:td_bank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:td_bank_na .

person:michael_k_makaitis a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citizens_bank_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:citizens_bank_na .

person:michael_mcmahon a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:keybank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:keybank_national_association .

person:peter_m_killea a base:Person ;
    <http://example.org/isInstanceOf/> position:executive_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank_na ;
            rel:position position:executive_director ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank_na .

person:randall_r_phillips a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:first_niagara_bank_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:first_niagara_bank_na .

person:richard_ferrari a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_bank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:wells_fargo_bank_na .

person:thomas_c_strasenburgh a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:trevor_williams a base:Person ;
    <http://example.org/isInstanceOf/> position:banking_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:branch_banking_and_trust_company ;
            rel:position position:banking_officer ] ;
    rel:isEmployedBy org1:branch_banking_and_trust_company .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender,
        org_role:syndication_agents ;
    rel:hasEmployee person:thomas_c_strasenburgh .

org1:branch_banking_and_trust_company a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:trevor_williams .

org1:citibank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:christine_keating .

org1:citizens_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lead_arrangers,
        org_role:lender ;
    rel:hasEmployee person:michael_k_makaitis .

org1:first_niagara_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:randall_r_phillips .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bookrunners,
        org_role:lender,
        org_role:syndication_agents ;
    rel:hasEmployee person:peter_m_killea .

org1:keybank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender,
        org_role:syndication_agents ;
    rel:hasEmployee person:michael_mcmahon .

org1:td_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agents,
        org_role:lender ;
    rel:hasEmployee person:craig_welch .

org1:wells_fargo_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:richard_ferrari .

org_role:bookrunners rdfs:subClassOf base:Organization .

org_role:lead_arrangers rdfs:subClassOf base:Organization .

position:banking_officer a base:Position ;
    base:positionName "Banking Officer" ;
    rdfs:subClassOf base:Person .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

position:executive_director a base:Position ;
    base:positionName "Executive Director" ;
    rdfs:subClassOf base:Person .

position:executive_vice_president_of_finance a base:Position ;
    base:positionName "Executive Vice President of Finance" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

org_role:syndication_agents rdfs:subClassOf base:Organization .

org1:monro_muffler_brake_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:catherine_damico .

org_role:documentation_agents rdfs:subClassOf base:Organization .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

