org1:moodys_investors_service_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agency .

org1:national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent .

org1:pnc_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent .

