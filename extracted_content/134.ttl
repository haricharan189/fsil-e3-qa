org1:guarantors_party a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors .

org1:jp_morgan_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bookrunning_manager,
        org_role:lead_arranger .

org1:lenders_party a base:Organization .

org1:union_gaming_advisors_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agent .

org_role:arranger rdfs:subClassOf base:Organization .

loc:383_madison_avenue_floor_24_new_york_ny_10179 a base:Location ;
    rel:isLocationOf org1:jpmorgan_chase_bank_na .

loc:4_embarcadero_center_suite_3300_san_francisco_ca_94111 a base:Location ;
    rel:isLocationOf org1:stockbridge_sbe_holdings_llc .

loc:500_stanton_christiana_road_ops_building_2_3rd_floor_newark_de_19713_2107 a base:Location ;
    rel:isLocationOf org1:jpmorgan_chase_bank_na .

loc:80_pine_street_new_york_ny_10005 a base:Location ;
    rel:isLocationOf org1:cahill_gordonand_reindel_llp .

org1:cahill_gordonand_reindel_llp a base:Organization ;
    rel:hasLocationAt loc:80_pine_street_new_york_ny_10005 .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:agent rdfs:subClassOf base:Organization .

org_role:bookrunning_manager rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:collateral_agent rdfs:subClassOf base:Organization .

org_role:documentation_agent rdfs:subClassOf base:Organization .

org_role:guarantors rdfs:subClassOf base:Organization .

org_role:holdings rdfs:subClassOf base:Organization .

org_role:issuing_bank rdfs:subClassOf base:Organization .

person:janet_chao a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:east_west_bank ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:east_west_bank .

person:mohammad_s_hasan a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank_na .

person:nelson_arteaga a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:banc_of_california_national_association ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:banc_of_california_national_association .

org1:banc_of_california_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:nelson_arteaga .

org1:east_west_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:janet_chao .

org1:sb_gaming_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:darren_drake .

org1:stockbridge_sbe_investment_company_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor,
        org_role:holdings ;
    rel:hasEmployee person:darren_drake .

org_role:guarantor rdfs:subClassOf base:Organization .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

org1:stockbridge_sbe_holdings_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:darren_drake ;
    rel:hasLocationAt loc:4_embarcadero_center_suite_3300_san_francisco_ca_94111 .

org_role:lender rdfs:subClassOf base:Organization .

person:darren_drake a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:stockbridge_sbe_holdings_llc ;
            rel:position position:authorized_signatory ],
        [ a rel:Employment ;
            rel:organization org1:sb_gaming_llc ;
            rel:position position:authorized_signatory ],
        [ a rel:Employment ;
            rel:organization org1:stockbridge_sbe_investment_company_llc ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:sb_gaming_llc,
        org1:stockbridge_sbe_holdings_llc,
        org1:stockbridge_sbe_investment_company_llc .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:agent,
        org_role:collateral_agent,
        org_role:issuing_bank,
        org_role:lender ;
    rel:hasEmployee person:mohammad_s_hasan ;
    rel:hasLocationAt loc:383_madison_avenue_floor_24_new_york_ny_10179,
        loc:500_stanton_christiana_road_ops_building_2_3rd_floor_newark_de_19713_2107 .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

