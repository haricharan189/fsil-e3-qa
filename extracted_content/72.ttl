@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:brown_rudnick_llp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:legal_counsel .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:syndication_agents .

loc:1000_stanley_drive_new_britain_connecticut_06053 a base:Location ;
    rel:isLocationOf org1:stanley_blackand_decker_inc .

loc:25_canada_square_canary_wharf_london_england_e14_5lb a base:Location ;
    <http://example.org/isInstanceOf/> location_type:uk_branch ;
    rel:isLocationOf org1:citigroup_global_markets_inc .

loc:building_3_1615_brett_road_new_castle_de_19720 a base:Location ;
    rel:isLocationOf org1:citibank .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:initial_borrower rdfs:subClassOf base:Organization .

org_role:legal_counsel rdfs:subClassOf base:Organization .

person:carolyn_kee a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citibank ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:citibank .

person:craig_a_douglas a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:stanley_blackand_decker_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:stanley_blackand_decker_inc ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:stanley_blackand_decker_inc .

person:john_summers a base:Person ;
    <http://example.org/isInstanceOf/> position:assistant_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citigroup_global_markets_inc ;
            rel:position position:assistant_vice_president ] ;
    rel:isEmployedBy org1:citigroup_global_markets_inc .

person:kay_reedy a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wells_fargo_securities_llc ;
            rel:position position:managing_director ] ;
    rel:isEmployedBy org1:wells_fargo_securities_llc .

person:ryan_durkin a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:goldman_sachs_bank_usa ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:goldman_sachs_bank_usa .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:book_runners,
        org_role:syndication_agents ;
    rel:hasEmployee person:ryan_durkin .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:book_runners,
        org_role:lead_arrangers ;
    rel:hasEmployee person:kay_reedy .

org_role:arrangers rdfs:subClassOf base:Organization .

org_role:syndication_agents rdfs:subClassOf base:Organization .

position:assistant_vice_president a base:Position ;
    base:positionName "Assistant Vice President" ;
    rdfs:subClassOf base:Person .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:managing_director a base:Position ;
    base:positionName "Managing Director\\n" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

org1:citibank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent ;
    rel:hasEmployee person:carolyn_kee ;
    rel:hasLocationAt loc:building_3_1615_brett_road_new_castle_de_19720 .

org1:citigroup_global_markets_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:book_runners ;
    rel:hasEmployee person:john_summers ;
    rel:hasLocationAt loc:25_canada_square_canary_wharf_london_england_e14_5lb .

org_role:book_runners rdfs:subClassOf base:Organization .

org1:stanley_blackand_decker_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:initial_borrower ;
    rel:hasEmployee person:craig_a_douglas ;
    rel:hasLocationAt loc:1000_stanley_drive_new_britain_connecticut_06053 .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

