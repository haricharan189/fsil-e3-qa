person:thomas_e_carter a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:nexstar_broadcasting_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:nexstar_media_group_inc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:nexstar_broadcasting_inc,
        org1:nexstar_media_group_inc .

position:assistant_vice_president a base:Position ;
    base:positionName "\\nAssistant Vice President" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

