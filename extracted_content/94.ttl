    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:pnc_capital_markets_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:bookrunners .

org1:suntrust_robinson_humphrey_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_bookrunners,
        org_role:joint_lead_arrangers .

loc:520_madison_avenue_new_york_ny_10022 a base:Location ;
    rel:isLocationOf org1:salix_pharmaceuticals_ltd .

loc:8510_colonnade_center_drive_raleigh_north_carolina_27615 a base:Location ;
    rel:isLocationOf org1:salix_pharmaceuticals_ltd .

org_role:agent rdfs:subClassOf base:Organization .

org_role:bank rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

person:adam_c_derbyshire a base:Person ;
    <http://example.org/isInstanceOf/> position:assistant_secretary,
        position:chief_financial_officer,
        position:executive_vice_president_finance_and_administration,
        position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:salix_pharmaceuticals_ltd ;
            rel:position position:assistant_secretary ],
        [ a rel:Employment ;
            rel:organization org1:salix_pharmaceuticals_ltd ;
            rel:position position:executive_vice_president_finance_and_administration ],
        [ a rel:Employment ;
            rel:organization org1:salix_pharmaceuticals_ltd ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:salix_pharmaceuticals_ltd ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:salix_pharmaceuticals_ltd .

person:ben_cumming a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:suntrust_bank ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:suntrust_bank .

