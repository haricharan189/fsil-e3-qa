@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

loc:two_international_place_17th_floor_boston_ma_02110 a base:Location ;
    rel:isLocationOf org1:crystal_financial_llc .

org_role:lender rdfs:subClassOf base:Organization .

org_role:term_agent rdfs:subClassOf base:Organization .

org1:crystal_financial_spv_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:term_lender ;
    rel:hasEmployee person:christopher_a_arnold .

org1:standard_outdoor_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:ian_w_estus .

org1:standard_outdoor_southeast_i_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:ian_w_estus .

org1:standard_outdoor_southeast_ii_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:ian_w_estus .

org1:standard_outdoor_southwest_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:ian_w_estus .

person:christopher_a_arnold a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_managing_directo,
        position:senior_managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:crystal_financial_llc ;
            rel:position position:senior_managing_director ],
        [ a rel:Employment ;
            rel:organization org1:crystal_financial_spv_llc ;
            rel:position position:senior_managing_directo ] ;
    rel:isEmployedBy org1:crystal_financial_llc,
        org1:crystal_financial_spv_llc .

position:chief_executive_officer a base:Position ;
    base:positionName "Chief Executive Officer" ;
    rdfs:subClassOf base:Person .

position:senior_managing_directo a base:Position ;
    base:positionName "Senior Managing Directo" ;
    rdfs:subClassOf base:Person .

position:senior_managing_director a base:Position ;
    base:positionName "Senior Managing Director" ;
    rdfs:subClassOf base:Person .

org1:crystal_financial_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender,
        org_role:term_agent ;
    rel:hasEmployee person:christopher_a_arnold ;
    rel:hasLocationAt loc:two_international_place_17th_floor_boston_ma_02110 .

org1:standard_diversified_opportunities_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:ian_w_estus .

org_role:borrower rdfs:subClassOf base:Organization .

person:ian_w_estus a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_executive_officer,
        position:president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:standard_diversified_opportunities_inc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:standard_diversified_opportunities_inc ;
            rel:position position:chief_executive_officer ],
        [ a rel:Employment ;
            rel:organization org1:standard_outdoor_southwest_llc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:standard_outdoor_southeast_ii_llc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:standard_outdoor_southeast_i_llc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:standard_outdoor_llc ;
            rel:position position:president ] ;
    rel:isEmployedBy org1:standard_diversified_opportunities_inc,
        org1:standard_outdoor_llc,
        org1:standard_outdoor_southeast_i_llc,
        org1:standard_outdoor_southeast_ii_llc,
        org1:standard_outdoor_southwest_llc .

position:president a base:Position ;
    base:positionName "President" ;
    rdfs:subClassOf base:Person .

