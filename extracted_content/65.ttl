org_role:agent rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

org_role:trustee rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:issuer rdfs:subClassOf base:Organization .

person:andrew_griffin a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:credit_suisse_ag_cayman_islands_branch ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:credit_suisse_ag_cayman_islands_branch .

person:brian_d_corum a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:managing_director ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:frank_mccormack a base:Person ;
    <http://example.org/isInstanceOf/> position:svp ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:truist_bank ;
            rel:position position:svp ] ;
    rel:isEmployedBy org1:truist_bank .

