org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:revolving_lender,
        org_role:swingline_lender ;
    rel:hasEmployee person:brian_d_corum .

org1:citizens_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:issuer,
        org_role:revolving_lender ;
    rel:hasEmployee person:sean_mcwhinnie .

org1:fifth_third_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:revolving_lender ;
    rel:hasEmployee person:lise_hinton .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:revolving_lender ;
    rel:hasEmployee person:thomas_manning .

org1:keybank_national_association a base:Organization ;
