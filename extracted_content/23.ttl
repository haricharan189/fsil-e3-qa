org1:vivint_solar_operations_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:tom_vonreichbauer .

org_role:l_c_issuer rdfs:subClassOf base:Organization .

position:secretary a base:Position ;
    base:positionName "Secretary" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:mufg_bank_ltd a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:michael_agrimis ;
    rel:hasLocationAt loc:arranger .

org1:credit_suisse_ag_cayman_islands_branch a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:komal_shah,
        person:nawshaer_safi .

org1:deutsche_bank_ag_new_york_branch a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:jeremy_eisman,
        person:kyle_hatze .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:managing_director a base:Position ;
    base:positionName "Managing Director" ;
    rdfs:subClassOf base:Person .

person:tom_vonreichbauer a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:sunrun_south_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:vivint_solar_operations_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:aee_solar_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:vivint_solar_developer_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:vivint_solar_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:sunrun_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:vivint_solar_holdings_inc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:aee_solar_inc,
        org1:sunrun_inc,
        org1:sunrun_south_llc,
        org1:vivint_solar_developer_llc,
        org1:vivint_solar_holdings_inc,
        org1:vivint_solar_inc,
        org1:vivint_solar_operations_llc .

org_role:guarantor rdfs:subClassOf base:Organization .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

