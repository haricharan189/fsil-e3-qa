    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:sunrun_installation_services_inc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:sunrun_installation_services_inc .

loc:arranger a base:Location ;
    rel:isLocationOf org1:keybanc_capital_markets_inc,
        org1:mufg_bank_ltd .

org1:aee_solar_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:tom_vonreichbauer .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:holli_balzar .

org1:clean_energy_experts_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:jeanna_steele .

org1:credit_agricole_corporate_and_investment_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:andrew_sidford .

org1:keybank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:l_c_issuer,
        org_role:lender ;
    rel:hasEmployee person:jonathan_m_bouvet .

org1:morgan_stanley_senior_funding_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:michael_king .

org1:royal_bank_of_canada a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:mark_w_condon .

org1:silicon_valley_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:collateral_agent,
        org_role:l_c_issuer,
        org_role:lender ;
    rel:hasEmployee person:jordan_kanis .

org1:sunrun_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:tom_vonreichbauer .

org1:sunrun_installation_services_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:paul_dickson .

org1:sunrun_south_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:tom_vonreichbauer .

org1:vivint_solar_developer_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:tom_vonreichbauer .

org1:vivint_solar_holdings_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:tom_vonreichbauer .

org1:vivint_solar_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
