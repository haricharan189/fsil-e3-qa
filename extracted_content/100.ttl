    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:bank_of_the_west_fifth_third_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent .

org1:mufg_union_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:sole_bookrunner .

org_role:bookrunner rdfs:subClassOf base:Organization .

loc:12670_high_bluff_drive_san_diego_california_92103 a base:Location ;
    rel:isLocationOf org1:lathamand_watkins_llp .

loc:400_hamilton_ave_suite110_palo_alto_ca_94301 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

