    rel:isLocationOf org1:apollo_investment_corporation .

org_role:advisor rdfs:subClassOf base:Organization .

org_role:agent rdfs:subClassOf base:Organization .

org_role:investment_manager rdfs:subClassOf base:Organization .

person:joseph_d_glatt a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:apollo_investment_corporation ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:apollo_investment_corporation .

person:maurice_amsellem a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:midcap_financial_trust ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:midcap_financial_trust .

loc:950_winter_street_waltham_ma_02451 a base:Location ;
    rel:isLocationOf org1:radius_health_inc,
        org1:radius_pharmaceuticals_inc .

org_role:borrowers rdfs:subClassOf base:Organization .

org_role:general_partner rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:josé_i_carmona a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:radius_pharmaceuticals_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:radius_health_inc ;
            rel:position position:treasurer ] ;
    rel:isEmployedBy org1:radius_health_inc,
        org1:radius_pharmaceuticals_inc .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:midcap_financial_trust a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasEmployee person:maurice_amsellem ;
    rel:hasLocationAt loc:7255_woodmont_avenue_suite_200_bethesda_maryland_20814 .

org1:radius_health_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:josé_i_carmona ;
    rel:hasLocationAt loc:950_winter_street_waltham_ma_02451 .

org1:radius_pharmaceuticals_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:josé_i_carmona ;
    rel:hasLocationAt loc:950_winter_street_waltham_ma_02451 .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

org1:apollo_investment_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:joseph_d_glatt ;
    rel:hasLocationAt loc:apollo_investment_corporation_730_fifth_avenue_11th_floor_new_york_new_york_10019,
        loc:apollo_investment_corporation_9_west_57th_street_37th_floor_new_york_new_york_10019 .

