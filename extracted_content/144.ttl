person:jonathan_krain a base:Person .

person:jose_carmona a base:Person .

person:sheriff_ibrahim a base:Person .

loc:7255_woodmont_avenue_suite_200_bethesda_maryland_20814 a base:Location ;
    rel:isLocationOf org1:midcap_financial_trust .

loc:apollo_investment_corporation_730_fifth_avenue_11th_floor_new_york_new_york_10019 a base:Location ;
    rel:isLocationOf org1:apollo_investment_corporation .

