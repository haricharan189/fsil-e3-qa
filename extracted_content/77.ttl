location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:fenner_and_smith_incorporated a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_lead_arrangers,
        org_role:oint_bookrunners .

org1:jp_morgan_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_lead_arrangers,
        org_role:oint_bookrunners .

org1:merrill_lynch a base:Organization .

org1:pierce a base:Organization .

org1:suntrust_robinson_humphrey a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_lead_arrangers,
        org_role:oint_bookrunners .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:joint_lead_arrangers,
        org_role:oint_bookrunners .

loc:10_south_dearborn_street_chicago_illinois_60603 a base:Location ;
    rel:isLocationOf org1:jpmorgan_chase_bank .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:issuing_bank rdfs:subClassOf base:Organization .

person:blair_w_todt a base:Person ;
    <http://example.org/isInstanceOf/> position:administrative_officer,
        position:chief_legal,
        position:secretary,
        position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wellcare_health_plans_inc ;
            rel:position position:chief_legal ],
        [ a rel:Employment ;
            rel:organization org1:wellcare_health_plans_inc ;
            rel:position position:administrative_officer ],
        [ a rel:Employment ;
            rel:organization org1:wellcare_health_plans_inc ;
            rel:position position:senior_vice_president ],
        [ a rel:Employment ;
            rel:organization org1:wellcare_health_plans_inc ;
            rel:position position:secretary ] ;
    rel:isEmployedBy org1:wellcare_health_plans_inc .

person:david_c_mruk a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:us_bank_national_association ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:us_bank_national_association .

person:hector_j_varona a base:Person ;
