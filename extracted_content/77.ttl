    rel:isEmployedBy org1:goldman_sachs_bank_usa .

person:teresa_stinson a base:Person ;
    <http://example.org/isInstanceOf/> position:svp_candi_banking ;
    rel:holdsPositionAt [ a rel:Employment ;
