org1:bank_of_america a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_syndication_agent,
        org_role:lender ;
    rel:hasEmployee person:mark_hardison .

org1:cadence_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:teresa_stinson .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_documentation_agent,
        org_role:lender ;
    rel:hasEmployee person:rebecca_kratz .

org1:hancock_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:kenneth_c_misemer .

org1:mufg_union_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_syndication_agent,
        org_role:joint_lead_arrangers,
        org_role:lender,
        org_role:oint_bookrunners ;
    rel:hasEmployee person:teuta_ghilaga .

org1:suntrust_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_syndication_agent,
        org_role:lender ;
    rel:hasEmployee person:katherine_bass .

org1:us_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_documentation_agent,
        org_role:lender ;
    rel:hasEmployee person:david_c_mruk .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_syndication_agent,
        org_role:lender ;
    rel:hasEmployee person:matthew_olson .

org_role:co_documentation_agent rdfs:subClassOf base:Organization .

position:administrative_officer a base:Position ;
    base:positionName "Administrative Officer" ;
    rdfs:subClassOf base:Person .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:chief_legal a base:Position ;
    base:positionName "Chief Legal" ;
    rdfs:subClassOf base:Person .

position:executive_director a base:Position ;
    base:positionName "Executive Director" ;
    rdfs:subClassOf base:Person .

position:secretary a base:Position ;
    base:positionName "Secretary" ;
    rdfs:subClassOf base:Person .

position:svp_candi_banking a base:Position ;
    base:positionName "SVP C&I Banking" ;
    rdfs:subClassOf base:Person .

org1:jpmorgan_chase_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:issuing_bank,
        org_role:lender ;
    rel:hasEmployee person:hector_j_varona ;
    rel:hasLocationAt loc:10_south_dearborn_street_chicago_illinois_60603 .

org_role:co_syndication_agent rdfs:subClassOf base:Organization .

org1:wellcare_health_plans_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:blair_w_todt .

org_role:joint_lead_arrangers rdfs:subClassOf base:Organization .

org_role:oint_bookrunners rdfs:subClassOf base:Organization .

