@prefix base: <http://example.org/base/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:bgsl_breckenridge_funding_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender .

org1:bgsl_jackson_hole_funding_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender .

org1:emerald_murray_street_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender .

org1:emerald_spring_street_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender .

org1:gn_loan_fund_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender .

org_role:agent rdfs:subClassOf base:Organization .

org_role:ally_representative rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:holdings_topco rdfs:subClassOf base:Organization .

org_role:l_c_issuer rdfs:subClassOf base:Organization .

person:danielle_spar a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:goldman_sachs_bank_usa ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:goldman_sachs_bank_usa .

person:eric_liaw a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_person ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:blackstone_holdings_finance_co_llc ;
            rel:position position:authorized_person ] ;
    rel:isEmployedBy org1:blackstone_holdings_finance_co_llc .

person:nicole_kroll a base:Person ;
    <http://example.org/isInstanceOf/> position:assistant_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wilmington_trust_national_association ;
            rel:position position:assistant_vice_president ] ;
    rel:isEmployedBy org1:wilmington_trust_national_association .

person:robert_j_shusterman a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:ally_bank ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:ally_bank .

org1:ally_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:ally_representative,
        org_role:l_c_issuer,
        org_role:lender ;
    rel:hasEmployee person:robert_j_shusterman .

org1:bgsl_big_sky_funding_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:marisa_beeney .

org1:blackstone_holdings_finance_co_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:eric_liaw .

org1:blackstone_private_credit_fund a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:marisa_beeney .

org1:blackstone_secured_lending_fund a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:marisa_beeney .

org1:emerald_direct_lending_1_limited_partnership a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:marisa_beeney .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:danielle_spar .

org1:ld_intermediate_holdings_inc a base:Organization ;
    rel:hasEmployee person:dawn_m_wilson .

org1:ld_topco_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:holdings_topco ;
    rel:hasEmployee person:dawn_m_wilson .

org1:wilmington_trust_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:collateral_agent ;
    rel:hasEmployee person:nicole_kroll .

org1:wvld_acquisition_corp a base:Organization ;
    rel:hasEmployee person:dawn_m_wilson .

position:assistant_vice_president a base:Position ;
    base:positionName "Assistant Vice President" ;
    rdfs:subClassOf base:Person .

org1:ld_lower_holdings_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:dawn_m_wilson .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

person:dawn_m_wilson a base:Person ;
    <http://example.org/isInstanceOf/> position:secretary,
        position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:ld_topco_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:ld_lower_holdings_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:ld_lower_holdings_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:ld_intermediate_holdings_inc ;
            rel:position position:secretary ],
        [ a rel:Employment ;
            rel:organization org1:wvld_acquisition_corp ;
            rel:position position:secretary ] ;
    rel:isEmployedBy org1:ld_intermediate_holdings_inc,
        org1:ld_lower_holdings_inc,
        org1:ld_topco_inc,
        org1:wvld_acquisition_corp .

person:marisa_beeney a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_person ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:blackstone_secured_lending_fund ;
            rel:position position:authorized_person ],
        [ a rel:Employment ;
            rel:organization org1:bgsl_big_sky_funding_llc ;
            rel:position position:authorized_person ],
        [ a rel:Employment ;
            rel:organization org1:emerald_direct_lending_1_limited_partnership ;
            rel:position position:authorized_person ],
        [ a rel:Employment ;
            rel:organization org1:blackstone_private_credit_fund ;
            rel:position position:authorized_person ] ;
    rel:isEmployedBy org1:bgsl_big_sky_funding_llc,
        org1:blackstone_private_credit_fund,
        org1:blackstone_secured_lending_fund,
        org1:emerald_direct_lending_1_limited_partnership .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:secretary a base:Position ;
    base:positionName "Secretary" ;
    rdfs:subClassOf base:Person .

position:authorized_person a base:Position ;
    base:positionName "Authorized Person" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

