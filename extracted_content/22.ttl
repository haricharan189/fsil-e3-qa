org_role:book_runner rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:runner rdfs:subClassOf base:Organization .

person:heath_israel a base:Person .

loc:1100_abernathy_road_suite_1600_130_atlanta_ga_30328 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

loc:3333_piedmont_road_suite_2500_atlanta_georgia_30305_attn_timothy_w_bratcher_esq a base:Location ;
    rel:isLocationOf org1:greenberg_traurig_llp .

loc:600_travis_street_suite_5400_houston_texas_77002 a base:Location ;
    rel:isLocationOf org1:simpson_thacher_and_bartlett_llp .

loc:three_allen_center_333_clay_street_suite_4620_houston_texas_77002 a base:Location ;
    rel:isLocationOf org1:oil_states_international_inc .

org1:greenberg_traurig_llp a base:Organization ;
    rel:hasLocationAt loc:3333_piedmont_road_suite_2500_atlanta_georgia_30305_attn_timothy_w_bratcher_esq .

org1:simpson_thacher_and_bartlett_llp a base:Organization ;
    rel:hasLocationAt loc:600_travis_street_suite_5400_houston_texas_77002 .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:joint_book_runner,
        org_role:joint_lead_arranger ;
    rel:hasLocationAt loc:1100_abernathy_road_suite_1600_130_atlanta_ga_30328 .

org_role:agent rdfs:subClassOf base:Organization .

person:ajay_jagsi a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:alexandre_camerlain a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:royal_bank_of_canada ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:royal_bank_of_canada .

person:anca_loghin a base:Person ;
