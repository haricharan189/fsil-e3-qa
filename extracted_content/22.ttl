    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank_na ;
            rel:position position:authorized_officer ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank_na .

person:lloyd_a_hajdik a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer,
        position:executive_vice_president,
        position:treasurer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:oil_states_international_inc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:oil_states_international_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:oil_states_international_inc ;
            rel:position position:executive_vice_president ] ;
    rel:isEmployedBy org1:oil_states_international_inc .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:joint_book_runner,
        org_role:lender ;
    rel:hasEmployee person:ajay_jagsi .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:joint_book_runner,
        org_role:lender ;
    rel:hasEmployee person:anca_loghin .

org1:royal_bank_of_canada a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:alexandre_camerlain .

org_role:arranger rdfs:subClassOf base:Organization .

position:authorized_officer a base:Position ;
    base:positionName "Authorized Officer" ;
    rdfs:subClassOf base:Person .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial\\nOfficer" ;
    rdfs:subClassOf base:Person .

