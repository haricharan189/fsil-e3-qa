position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

org1:oil_states_international_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:counsel_to_borrowers_borrower ;
    rel:hasEmployee person:lloyd_a_hajdik ;
    rel:hasLocationAt loc:three_allen_center_333_clay_street_suite_4620_houston_texas_77002 .

