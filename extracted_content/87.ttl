@prefix base: <http://example.org/base/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:morgan_lewisand_bockius_llp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:legal_counsel .

org_role:bank_of_america rdfs:subClassOf base:Organization .

org_role:kpmg_llp rdfs:subClassOf base:Organization .

org_role:l_c_issuer rdfs:subClassOf base:Organization .

org_role:swingline_lender rdfs:subClassOf base:Organization .

person:jennifer_yan a base:Person .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:guarantor rdfs:subClassOf base:Organization .

org_role:legal_counsel rdfs:subClassOf base:Organization .

person:chris_hursey a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:suntrust_bank ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:suntrust_bank .

person:douglas_b_bingham a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:afi_licensing_llc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:afi_licensing_llc ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:afi_licensing_llc .

person:john_emery a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank ;
            rel:position position:managing_director ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank .

person:melissa_mullis a base:Person ;
    <http://example.org/isInstanceOf/> position:assistant_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america ;
            rel:position position:assistant_vice_president ] ;
    rel:isEmployedBy org1:bank_of_america .

person:robert_levins a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_credit_manager ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:hsbc_bank_usa ;
            rel:position position:senior_credit_manager ] ;
    rel:isEmployedBy org1:hsbc_bank_usa .

person:ronald_d_ford a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer,
        position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:armstrongflooringinc ;
            rel:position position:senior_vice_president ],
        [ a rel:Employment ;
            rel:organization org1:armstrongflooringinc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:armstrongflooringinc .

person:sarah_c_lesser a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:manufacturers_and_traders_trust_company ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:manufacturers_and_traders_trust_company .

org1:bank_of_america a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent ;
    rel:hasEmployee person:melissa_mullis .

org1:hsbc_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:robert_levins .

org1:jpmorgan_chase_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:john_emery .

org1:manufacturers_and_traders_trust_company a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:sarah_c_lesser .

org1:suntrust_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:chris_hursey .

position:assistant_vice_president a base:Position ;
    base:positionName "Assistant Vice President" ;
    rdfs:subClassOf base:Person .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:managing_director a base:Position ;
    base:positionName "Managing Director" ;
    rdfs:subClassOf base:Person .

position:senior_credit_manager a base:Position ;
    base:positionName "Senior Credit Manager" ;
    rdfs:subClassOf base:Person .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

org1:afi_licensing_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:douglas_b_bingham .

org1:armstrongflooringinc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:ronald_d_ford .

org_role:lender rdfs:subClassOf base:Organization .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

