@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:bofa_securities a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:bookrunner .

org1:bofa_securities_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bookrunner,
        org_role:sole_lead_arranger .

org_role:agent rdfs:subClassOf base:Organization .

loc:new_york a base:Location ;
    rel:isLocationOf org1:deutsche_bank_ag .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:l_c_issuer rdfs:subClassOf base:Organization .

org_role:lenders rdfs:subClassOf base:Organization .

person:annie_carr a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:goldman_sachs_bank ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:goldman_sachs_bank .

person:annie_chung a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:deutsche_bank_ag ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:deutsche_bank_ag .

person:darren_merten a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:eugene_yermash a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citibank_na ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:citibank_na .

person:heather_e_hoopingarner a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank_na ;
            rel:position position:authorized_signer ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank_na .

person:julie_lilienfeld a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:morgan_stanley_bank_na ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:morgan_stanley_bank_na .

person:michael_dambach a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:biogen_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:biogen_inc ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:biogen_inc .

person:ming_k_chu a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:deutsche_bank_ag ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:deutsche_bank_ag .

person:raymond_qiao a base:Person ;
    <http://example.org/isInstanceOf/> position:executive_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_china_new_york_branch ;
            rel:position position:executive_vice_president ] ;
    rel:isEmployedBy org1:bank_of_china_new_york_branch .

person:ryan_m_black a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:us_bank_national_association ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:us_bank_national_association .

person:taelitha_bonds_harris a base:Person ;
    <http://example.org/isInstanceOf/> position:assistant_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:assistant_vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

person:teddy_koch a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:wellsfargobanknationalassociation ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:wellsfargobanknationalassociation .

person:tracy_rahn a base:Person ;
    <http://example.org/isInstanceOf/> position:executive_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:mizuho_bank ;
            rel:position position:executive_director ] ;
    rel:isEmployedBy org1:mizuho_bank .

loc:usa a base:Location ;
    rel:isLocationOf org1:goldman_sachs_bank,
        org1:mizuho_bank .

org1:bank_of_china_new_york_branch a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:raymond_qiao .

org1:citibank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:eugene_yermash .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:heather_e_hoopingarner .

org1:morgan_stanley_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:julie_lilienfeld .

org1:us_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:ryan_m_black .

org1:wellsfargobanknationalassociation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:teddy_koch .

org_role:bookrunner rdfs:subClassOf base:Organization .

position:assistant_vice_president a base:Position ;
    base:positionName "Assistant Vice President" ;
    rdfs:subClassOf base:Person .

position:authorized_signer a base:Position ;
    base:positionName "Authorized Signer" ;
    rdfs:subClassOf base:Person .

position:executive_director a base:Position ;
    base:positionName "Executive Director" ;
    rdfs:subClassOf base:Person .

position:executive_vice_president a base:Position ;
    base:positionName "Executive Vice President" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

org1:biogen_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:michael_dambach .

org1:goldman_sachs_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:annie_carr ;
    rel:hasLocationAt loc:usa .

org1:mizuho_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:tracy_rahn ;
    rel:hasLocationAt loc:usa .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:l_c_issuer,
        org_role:lender,
        org_role:lenders ;
    rel:hasEmployee person:darren_merten,
        person:taelitha_bonds_harris .

position:authorized_signatory a base:Position ;
    base:positionName "Authorized Signatory" ;
    rdfs:subClassOf base:Person .

org1:deutsche_bank_ag a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:lender ;
    rel:hasEmployee person:annie_chung,
        person:ming_k_chu ;
    rel:hasLocationAt loc:new_york .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org_role:agents rdfs:subClassOf base:Organization .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

org_role:lender rdfs:subClassOf base:Organization .

