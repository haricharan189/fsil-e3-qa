    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:pnc_capital_markets_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:bookrunner .

org_role:agent rdfs:subClassOf base:Organization .

loc:121_caldwell_street_titusville_pa_16354 a base:Location ;
    rel:isLocationOf org1:universal_stainlessand_alloy_products_inc .

loc:2058_south_bailey_road_north_jackson_oh_44541 a base:Location ;
    <http://example.org/isInstanceOf/> location_type:chief_executive_office ;
    rel:isLocationOf org1:north_jackson_specialty_steel_llc .

loc:300_fifth_avenue_14th_floor_pittsburgh_pennsylvania_15222 a base:Location ;
    rel:isLocationOf org1:pnc_bank_national_association .

