    rel:isLocationOf org1:pnc_bank_na .

org1:dunkirk_specialty_steel_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasLocationAt loc:830_brigham_road_dunkirk_ny_14048 .

org1:north_jackson_specialty_steel_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasLocationAt loc:2058_south_bailey_road_north_jackson_oh_44541 .

org1:pnc_bank_na a base:Organization ;
    rel:hasLocationAt loc:two_tower_center_blvd_21st_floor_east_brunswick_nj_08816 .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:bookrunner rdfs:subClassOf base:Organization .

person:david_b_thayer a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:pnc_bank_national_association ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:pnc_bank_national_association .

person:james_foley a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_america_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:bank_of_america_na .

org1:universal_stainlessand_alloy_products_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasLocationAt loc:121_caldwell_street_titusville_pa_16354,
        loc:600_mayer_street_bridgeville_pa_15017 .

org_role:lender rdfs:subClassOf base:Organization .

position:senior_vice_president a base:Position ;
    base:positionName "Senior Vice President" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:co_collateral_agent,
        org_role:lender ;
    rel:hasEmployee person:james_foley ;
    rel:hasLocationAt loc:one_bryant_park_32nd_floor_new_york_ny_10036 .

org1:universalstainlessandalloy_productsinc a base:Organization ;
    rel:hasEmployee person:rosscwilkin .

org_role:borrower rdfs:subClassOf base:Organization .

person:rosscwilkin a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financeofficer,
        position:treasurer,
        position:vicepresidentoffinance ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:northjacksonspecialtysteel_llc ;
            rel:position position:chief_financeofficer ],
        [ a rel:Employment ;
            rel:organization org1:dunkirkspecialtysteelllc ;
            rel:position position:vicepresidentoffinance ],
        [ a rel:Employment ;
            rel:organization org1:northjacksonspecialtysteel_llc ;
            rel:position position:vicepresidentoffinance ],
        [ a rel:Employment ;
            rel:organization org1:dunkirkspecialtysteelllc ;
            rel:position position:chief_financeofficer ],
        [ a rel:Employment ;
            rel:organization org1:universalstainlessandalloy_productsinc ;
            rel:position position:chief_financeofficer ],
        [ a rel:Employment ;
            rel:organization org1:universalstainlessandalloy_productsinc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:northjacksonspecialtysteel_llc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:dunkirkspecialtysteelllc ;
            rel:position position:treasurer ] ;
    rel:isEmployedBy org1:dunkirkspecialtysteelllc,
        org1:northjacksonspecialtysteel_llc,
        org1:universalstainlessandalloy_productsinc .

position:vicepresidentoffinance a base:Position ;
    base:positionName "Vice President of Finance" ;
    rdfs:subClassOf base:Person .

org1:dunkirkspecialtysteelllc a base:Organization ;
    rel:hasEmployee person:rosscwilkin .

org1:northjacksonspecialtysteel_llc a base:Organization ;
    rel:hasEmployee person:rosscwilkin .

org1:pnc_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:co_collateral_agent,
        org_role:lender ;
    rel:hasEmployee person:david_b_thayer ;
    rel:hasLocationAt loc:300_fifth_avenue_14th_floor_pittsburgh_pennsylvania_15222,
        loc:6750_miller_rd_mail_stop_br_yb58_01_p_brecksville_ohio_44141 .

position:chief_financeofficer a base:Position ;
    base:positionName "Chief	 	\\n 		 		 	Finance Officer" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

