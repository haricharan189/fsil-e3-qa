    rel:isLocationOf org1:universal_stainlessand_alloy_products_inc .

loc:6750_miller_rd_mail_stop_br_yb58_01_p_brecksville_ohio_44141 a base:Location ;
    rel:isLocationOf org1:pnc_bank_national_association .

loc:830_brigham_road_dunkirk_ny_14048 a base:Location ;
    <http://example.org/isInstanceOf/> location_type:chief_executive_office ;
