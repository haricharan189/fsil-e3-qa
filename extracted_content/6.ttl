@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

loc:2001_ross_avenue_suite_600_dallas_texas_75201 a base:Location ;
    rel:isLocationOf org1:baker_botts_llp .

loc:2800_post_oak_boulevard_suite_4800_houston_texas_77056 a base:Location ;
    rel:isLocationOf org1:hines_reit_one_wilshire_lp .

loc:333_s_hope_street_39th_floor_los_angeles_california_90071 a base:Location ;
    rel:isLocationOf org1:seyfarth_shaw_llp .

loc:444_s_flower_street_39th_floor_los_angeles_california_90071 a base:Location ;
    rel:isLocationOf org1:bank_of_china .

loc:los_angeles a base:Location ;
    <http://example.org/isInstanceOf/> location_type:branch ;
    rel:isLocationOf org1:bank_of_china .

org1:baker_botts_llp a base:Organization ;
    rel:hasLocationAt loc:2001_ross_avenue_suite_600_dallas_texas_75201 .

org1:seyfarth_shaw_llp a base:Organization ;
    rel:hasLocationAt loc:333_s_hope_street_39th_floor_los_angeles_california_90071 .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:j_shea_morgenroth a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_agent ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:hines_reit_one_wilshire_lp ;
            rel:position position:authorized_agent ] ;
    rel:isEmployedBy org1:hines_reit_one_wilshire_lp .

person:ying_chen a base:Person ;
    <http://example.org/isInstanceOf/> position:deputy_branch_manager,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bank_of_china ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:bank_of_china ;
            rel:position position:deputy_branch_manager ] ;
    rel:isEmployedBy org1:bank_of_china .

position:authorized_agent a base:Position ;
    base:positionName "Authorized Agent" ;
    rdfs:subClassOf base:Person .

position:deputy_branch_manager a base:Position ;
    base:positionName "Deputy Branch Manager" ;
    rdfs:subClassOf base:Person .

position:vice_president a base:Position ;
    base:positionName "Vice President" ;
    rdfs:subClassOf base:Person .

org1:hines_reit_one_wilshire_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:j_shea_morgenroth ;
    rel:hasLocationAt loc:2800_post_oak_boulevard_suite_4800_houston_texas_77056 .

org1:bank_of_china a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:ying_chen ;
    rel:hasLocationAt loc:444_s_flower_street_39th_floor_los_angeles_california_90071,
        loc:los_angeles .

