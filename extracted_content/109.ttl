@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

person:brian_j_sohocki a base:Person .

person:gregory_d_cribbs a base:Person .

loc:437_grant_street_frick_building_suite_1600_pittsburgh_pa_15219 a base:Location ;
    rel:isLocationOf org1:first_commonwealth_bank .

loc:5001_baum_blvd_ste_770_pittsburgh_pa_15213 a base:Location ;
    rel:isLocationOf org1:liberated_syndication_inc .

loc:babst_calland_clements_and_zomnir_pc_two_gateway_center_pittsburgh_pa_15222 a base:Location ;
    rel:isLocationOf org1:first_commonwealth_bank .

org_role:bank rdfs:subClassOf base:Organization .

org_role:borrowers rdfs:subClassOf base:Organization .

person:denis_yevstifeyey a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc .

person:douglas_polinksy a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc .

person:j_gregory_smith a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc .

person:john_busshaus a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc .

org1:first_commonwealth_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bank ;
    rel:hasLocationAt loc:437_grant_street_frick_building_suite_1600_pittsburgh_pa_15219,
        loc:babst_calland_clements_and_zomnir_pc_two_gateway_center_pittsburgh_pa_15222 .

person:christopher_j_spencer a base:Person ;
    <http://example.org/isInstanceOf/> position:ceo,
        position:chief_executive_officer_and_chairman_of_the_board ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:liberated_syndication_inc ;
            rel:position position:ceo ],
        [ a rel:Employment ;
            rel:organization org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc ;
            rel:position position:chief_executive_officer_and_chairman_of_the_board ] ;
    rel:isEmployedBy org1:liberated_syndication_inc,
        org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc .

position:ceo a base:Position ;
    base:positionName "CEO" ;
    rdfs:subClassOf base:Person .

position:chief_executive_officer_and_chairman_of_the_board a base:Position ;
    base:positionName "Chief Executive Officer and Chairman of the Board" ;
    rdfs:subClassOf base:Person .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

org1:liberated_syndication_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrowers ;
    rel:hasEmployee person:christopher_j_spencer ;
    rel:hasLocationAt loc:5001_baum_blvd_ste_770_pittsburgh_pa_15213 .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

org1:liberated_syndication_inc_webmayhem_inc_and_pair_networks_inc a base:Organization ;
    rel:hasEmployee person:christopher_j_spencer,
        person:denis_yevstifeyey,
        person:douglas_polinksy,
        person:j_gregory_smith,
        person:john_busshaus .

