org1:the_northern_trust_company a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bank ;
    rel:hasEmployee person:john_lascody .

org1:us_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bank ;
    rel:hasEmployee person:jeff_benedix .

org_role:agents rdfs:subClassOf base:Organization .

org_role:arrangers rdfs:subClassOf base:Organization .

org_role:bookrunners rdfs:subClassOf base:Organization .

position:executive_vice_president a base:Position ;
    base:positionName "Executive Vice President" ;
    rdfs:subClassOf base:Person .

position:treasurer a base:Position ;
    base:positionName "Treasurer" ;
    rdfs:subClassOf base:Person .

position:vice_president_of_tax a base:Position ;
    base:positionName "Vice President of Tax" ;
