    <http://example.org/isInstanceOf/> org_role:agents,
        org_role:bank,
        org_role:servicing_agent ;
    rel:hasEmployee person:carolyn_kee ;
    rel:hasLocationAt loc:1615_brett_road_building_3_new_castle_de_19720 .

org1:jpmorgan_chase_bank_na a base:Organization ;
