org1:bank_of_the_west a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bank ;
    rel:hasEmployee person:adriana_collins .

org1:goldman_sachs_bank_usa a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:bank ;
    rel:hasEmployee person:annie_carr .

