person:martin_h_dodd a base:Person ;
    <http://example.org/isInstanceOf/> position:general_counsel,
        position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:trc_companies_inc ;
            rel:position position:senior_vice_president ],
        [ a rel:Employment ;
            rel:organization org1:trc_companies_inc ;
            rel:position position:general_counsel ] ;
    rel:isEmployedBy org1:trc_companies_inc .

person:mitchell_b_feldman a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:santander_bank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:santander_bank_na .

org1:citizens_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:bookrunner,
        org_role:lead_arranger,
        org_role:swingline_lender ;
    rel:hasEmployee person:marc_j_lubelczyk .

org_role:lc_issuer rdfs:subClassOf base:Organization .

position:director a base:Position ;
    base:positionName "Director" ;
    rdfs:subClassOf base:Person .

position:general_counsel a base:Position ;
    base:positionName "General Counsel" ;
    rdfs:subClassOf base:Person .

position:senior_banker a base:Position ;
    base:positionName "Senior Banker" ;
    rdfs:subClassOf base:Person .

org1:bmo_harris_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lc_issuer,
        org_role:lender,
        org_role:syndication_agent ;
    rel:hasEmployee person:john_dillon ;
    rel:hasLocationAt loc:111_w_monroe_street_5thfloor_center_chicago_il_60603 .

org1:citibank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:marina_e_grossi ;
    rel:hasLocationAt loc:6400_las_colinas_boulevard_irvine_tx_75039 .

org1:eastern_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:david_nussbaum ;
    rel:hasLocationAt loc:eastern_bank_265_franklin_street_2nd_floor_boston_ma_02110 .

org1:keybank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:documentation_agent,
        org_role:lender ;
    rel:hasEmployee person:je_hall ;
    rel:hasLocationAt loc:225_franklin_street_18th_floor_boston_ma_02110 .

org1:middlesex_savings_bank a base:Organization ;
