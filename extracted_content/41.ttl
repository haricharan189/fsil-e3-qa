    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:keybank_national_association ;
            rel:position position:senior_banker ] ;
    rel:isEmployedBy org1:keybank_national_association .

person:john_dillon a base:Person ;
    <http://example.org/isInstanceOf/> position:director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:bmo_harris_bank_na ;
            rel:position position:director ] ;
    rel:isEmployedBy org1:bmo_harris_bank_na .

person:marc_j_lubelczyk a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citizens_bank_na ;
            rel:position position:senior_vice_president ] ;
    rel:isEmployedBy org1:citizens_bank_na .

person:marina_e_grossi a base:Person ;
    <http://example.org/isInstanceOf/> position:senior_vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:citibank_na ;
            rel:position position:senior_vice_president ] ;
