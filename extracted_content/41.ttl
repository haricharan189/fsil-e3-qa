    rel:hasEmployee person:deborah_a_colony ;
    rel:hasLocationAt loc:6_main_street_natick_ma_01760 .

org1:santander_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:mitchell_b_feldman ;
    rel:hasLocationAt loc:28_state_street_16th_floor_ma2_6560_cb16_boston_ma_02109 .

org1:trc_companies_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:martin_h_dodd .

org1:webster_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
