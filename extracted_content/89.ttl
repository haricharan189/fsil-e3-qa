person:james_b_pekarek a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:agiliti_surgical_inc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:agiliti_surgical_inc .

person:james_pekarek a base:Person ;
    <http://example.org/isInstanceOf/> position:cfo ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:agiliti_healthinc ;
            rel:position position:cfo ] ;
    rel:isEmployedBy org1:agiliti_healthinc .

person:lee_neumann a base:Person ;
    <http://example.org/isInstanceOf/> position:general_counsel,
        position:svp,
        position:vp_finance ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:agiliti_healthinc ;
            rel:position position:vp_finance ],
        [ a rel:Employment ;
            rel:organization org1:agiliti_healthinc ;
            rel:position position:svp ],
        [ a rel:Employment ;
            rel:organization org1:agiliti_healthinc ;
            rel:position position:general_counsel ] ;
    rel:isEmployedBy org1:agiliti_healthinc .

