org1:jpmorgan_chase_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:arrangers,
        org_role:bookrunners ;
    rel:hasEmployee person:sabir_hashmy ;
    rel:hasLocationAt loc:10_s_dearborn_chicagoil_60603 .

position:cfo a base:Position ;
    base:positionName "CFO" ;
    rdfs:subClassOf base:Person .

org_role:bookrunners rdfs:subClassOf base:Organization .

org_role:arrangers rdfs:subClassOf base:Organization .

org1:agiliti_healthinc a base:Organization ;
    rel:hasEmployee person:james_pekarek,
        person:lee_neumann,
        person:matthew_mccabe ;
    rel:hasLocationAt loc:6625_west_78th_street_suite300_minneapolis_mn_55439 .

