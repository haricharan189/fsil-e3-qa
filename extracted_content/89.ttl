    <http://example.org/isInstanceOf/> position:cfo ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:agiliti_healthinc ;
            rel:position position:cfo ] ;
    rel:isEmployedBy org1:agiliti_healthinc .

person:sabir_hashmy a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank ;
            rel:position position:managing_director ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank .

org1:agiliti_surgical_inc a base:Organization ;
    rel:hasEmployee person:james_b_pekarek .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

position:general_counsel a base:Position ;
    base:positionName "General Counsel" ;
    rdfs:subClassOf base:Person .

