@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix person: <http://example.org/person_name/> .
@prefix position: <http://example.org/person_position/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:pharmakon_management_i_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:general_partner .

org_role:credit_party rdfs:subClassOf base:Organization .

org_role:partner rdfs:subClassOf base:Organization .

person:geoffrey_e_secol a base:Person .

person:jen_porter a base:Person .

person:paul_brannelly a base:Person .

person:shirley_kuhlmann a base:Person .

position:company_secretary rdfs:subClassOf base:Person .

loc:100_technology_center_drive_suite_300_stoughton_ma_02072 a base:Location ;
    rel:isLocationOf org1:collegium_pharmaceutical_inc .

loc:110_east_59th_street_3300_new_york_ny_10022 a base:Location ;
    rel:isLocationOf org1:pharmakon_advisors_lp .

loc:3000_two_logan_square_philadelphia_pa_19103 a base:Location ;
    rel:isLocationOf org1:pepper_hamilton_llp .

loc:51_new_north_road_exeter_ex4_4ep_united_kingdom a base:Location ;
    rel:isLocationOf org1:biopharma_credit_plc .

loc:cayman_corporate_centre_27_hospital_road_george_town_grand_cayman_ky1_9008 a base:Location ;
    rel:isLocationOf org1:biopharma_credit_investments_v_master_lp .

loc:one_bryant_park_new_york_ny_10036_6745 a base:Location ;
    rel:isLocationOf org1:akin_gump_strauss_hauer_and_feld_llp .

org1:akin_gump_strauss_hauer_and_feld_llp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:lender ;
    rel:hasLocationAt loc:one_bryant_park_new_york_ny_10036_6745 .

org1:pepper_hamilton_llp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasLocationAt loc:3000_two_logan_square_philadelphia_pa_19103 .

org1:pharmakon_advisors_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:agent,
        org_role:investment_manager,
        org_role:lender ;
    rel:hasLocationAt loc:110_east_59th_street_3300_new_york_ny_10022 .

org_role:investment_manager rdfs:subClassOf base:Organization .

org1:collegium_securities_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:additional_credit_party ;
    rel:hasEmployee person:joseph_ciaffoni .

org_role:agent rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

person:joseph_ciaffoni a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_executive_officer,
        position:president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:collegium_pharmaceutical_inc ;
            rel:position position:president ],
        [ a rel:Employment ;
            rel:organization org1:collegium_pharmaceutical_inc ;
            rel:position position:chief_executive_officer ],
        [ a rel:Employment ;
            rel:organization org1:collegium_securities_corporation ;
            rel:position position:president ] ;
    rel:isEmployedBy org1:collegium_pharmaceutical_inc,
        org1:collegium_securities_corporation .

person:pedro_gonzalez_de_cosio a base:Person ;
    <http://example.org/isInstanceOf/> position:ceo,
        position:managing_member ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:biopharma_credit_plc ;
            rel:position position:managing_member ],
        [ a rel:Employment ;
            rel:organization org1:biopharma_credit_investments_v_master_lp ;
            rel:position position:managing_member ],
        [ a rel:Employment ;
            rel:organization org1:biopharma_credit_investments_v_master_lp ;
            rel:position position:ceo ],
        [ a rel:Employment ;
            rel:organization org1:biopharma_credit_plc ;
            rel:position position:ceo ] ;
    rel:isEmployedBy org1:biopharma_credit_investments_v_master_lp,
        org1:biopharma_credit_plc .

position:chief_executive_officer a base:Position ;
    base:positionName "Chief Executive Officer" ;
    rdfs:subClassOf base:Person .

position:ceo a base:Position ;
    base:positionName "CEO" ;
    rdfs:subClassOf base:Person .

position:managing_member a base:Position ;
    base:positionName "Managing Member" ;
    rdfs:subClassOf base:Person .

position:president a base:Position ;
    base:positionName "President" ;
    rdfs:subClassOf base:Person .

org1:biopharma_credit_investments_v_master_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender ;
    rel:hasEmployee person:pedro_gonzalez_de_cosio ;
    rel:hasLocationAt loc:cayman_corporate_centre_27_hospital_road_george_town_grand_cayman_ky1_9008 .

org1:biopharma_credit_plc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:collateral_agent,
        org_role:lender ;
    rel:hasEmployee person:pedro_gonzalez_de_cosio ;
    rel:hasLocationAt loc:51_new_north_road_exeter_ex4_4ep_united_kingdom .

org1:collegium_pharmaceutical_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:joseph_ciaffoni ;
    rel:hasLocationAt loc:100_technology_center_drive_suite_300_stoughton_ma_02072 .

org_role:lender rdfs:subClassOf base:Organization .

