@prefix base: <http://example.org/base/> .
@prefix loc: <http://example.org/location/> .
@prefix location_type: <http://example.org/location_type/> .
@prefix org1: <http://example.org/org_name/> .
@prefix org_role: <http://example.org/org_role/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rel: <http://example.org/relation/> .

base:Location a rdfs:Class .

base:Organization a rdfs:Class .

base:Person a rdfs:Class .

location_type:address_for_notices a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:agency_management a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:associate a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:branch_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:cayman_islands_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:chief_executive_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:corporate_headquarters a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:dba_bank_of_oklahoma a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_corporate_debt_products a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_trade_operations a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:global_ts_contractand_documentation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:loan_and_agency_services_group a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:los_angeles_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:new_york_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:ohio_banking_corporation a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:payment_processing_center a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:registered_office a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:bank_of_america_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lenders .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lead_arranger,
        org_role:syndication_agent .

org_role:agent rdfs:subClassOf base:Organization .

org_role:arranger rdfs:subClassOf base:Organization .

loc:1000_louisiana_3rd_floor_houston_texas_77002 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

loc:1900_west_loop_south_suite_1500_houston_texas_77027 a base:Location ;
    rel:isLocationOf org1:quanex_building_products_corporation .

loc:mac_d1109_019_1525_west_w_t_harris_blvd_charlotte_nc_28262 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

org1:edgetech_holding_co a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:ohio .

org1:mikron_industries_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:washington .

org1:mikron_washington_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:washington .

org1:nichols_aluminum_alabama_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:delaware .

org1:nichols_aluminum_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:delaware .

org1:quanex_building_products_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasLocationAt loc:1900_west_loop_south_suite_1500_houston_texas_77027 .

org1:quanex_homeshield_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:delaware .

org1:quanex_ig_systems_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:ohio .

org1:quanex_screens_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:delaware .

org1:quanex_services_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:delaware .

org1:truseal_technologies_inc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantors ;
    rel:hasLocationAt loc:delaware .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

loc:ohio a base:Location ;
    rel:isLocationOf org1:edgetech_holding_co,
        org1:quanex_ig_systems_inc .

loc:washington a base:Location ;
    rel:isLocationOf org1:mikron_industries_inc,
        org1:mikron_washington_llc .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender,
        org_role:lenders ;
    rel:hasLocationAt loc:1000_louisiana_3rd_floor_houston_texas_77002,
        loc:mac_d1109_019_1525_west_w_t_harris_blvd_charlotte_nc_28262 .

org_role:lenders rdfs:subClassOf base:Organization .

loc:delaware a base:Location ;
    rel:isLocationOf org1:nichols_aluminum_alabama_llc,
        org1:nichols_aluminum_llc,
        org1:quanex_homeshield_llc,
        org1:quanex_screens_llc,
        org1:quanex_services_inc,
        org1:truseal_technologies_inc .

org_role:guarantors rdfs:subClassOf base:Organization .

