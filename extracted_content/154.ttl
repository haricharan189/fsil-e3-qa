person:andrew_lee a base:Person .

person:paul_bokota a base:Person .

person:tischar_n_luckett a base:Person .

loc:10_south_dearborn_floor_l2_suite_il1_1145_chicago_il_60603_2300 a base:Location ;
    <http://example.org/isInstanceOf/> location_type:middle_market_servicing ;
    rel:isLocationOf org1:jpmorgan_chase_bank_na .

loc:2165_e_spring_st_long_beach_ca_90806 a base:Location ;
    rel:isLocationOf org1:edge_systems_llc .

loc:4_new_york_plaza_floor_17_new_york_ny_10004 a base:Location ;
    <http://example.org/isInstanceOf/> location_type:commercial_banking ;
    rel:isLocationOf org1:jpmorgan_chase_bank_na .

org_role:administrative_agent rdfs:subClassOf base:Organization .

org_role:bookrunner rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

org_role:sole_lead_arranger rdfs:subClassOf base:Organization .

person:erica_cross a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:jpmorgan_chase_bank_na ;
            rel:position position:authorized_officer ] ;
    rel:isEmployedBy org1:jpmorgan_chase_bank_na .

org1:edge_systems_intermediate_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:liyuan_woo .

org1:the_hydrafacial_company_mexico_holdings_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor ;
    rel:hasEmployee person:liyuan_woo .

org_role:guarantor rdfs:subClassOf base:Organization .

position:authorized_officer a base:Position ;
    base:positionName "Authorized Officer" ;
    rdfs:subClassOf base:Person .

org1:edge_systems_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasEmployee person:liyuan_woo ;
    rel:hasLocationAt loc:2165_e_spring_st_long_beach_ca_90806 .

person:liyuan_woo a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:the_hydrafacial_company_mexico_holdings_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:edge_systems_intermediate_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:edge_systems_llc ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:edge_systems_intermediate_llc,
        org1:edge_systems_llc,
        org1:the_hydrafacial_company_mexico_holdings_llc .

org1:jpmorgan_chase_bank_na a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:bookrunner,
        org_role:lender,
        org_role:sole_lead_arranger ;
    rel:hasEmployee person:erica_cross ;
    rel:hasLocationAt loc:10_south_dearborn_floor_l2_suite_il1_1145_chicago_il_60603_2300,
        loc:4_new_york_plaza_floor_17_new_york_ny_10004 .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

