person:william_c_whitaker a base:Person ;
    <http://example.org/isInstanceOf/> position:treasurer,
        position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:ashland_chemco_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:ashland_global_holdings_inc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:ashland_llc ;
            rel:position position:vice_president ],
        [ a rel:Employment ;
            rel:organization org1:ashland_global_holdings_inc ;
            rel:position position:treasurer ],
        [ a rel:Employment ;
            rel:organization org1:ashland_llc ;
            rel:position position:treasurer ] ;
    rel:isEmployedBy org1:ashland_chemco_inc,
        org1:ashland_global_holdings_inc,
        org1:ashland_llc .

