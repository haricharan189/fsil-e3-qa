    <http://example.org/isInstanceOf/> org_role:arrangers,
        org_role:bookrunners .

org1:tau_operating_partnership_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower .

org1:wells_fargo_securities_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:arranger,
        org_role:arrangers,
        org_role:joint_bookrunner,
        org_role:joint_bookrunners .

org1:wellsfargobanknationalassociation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:lender .

org_role:agent rdfs:subClassOf base:Organization .

org_role:bookrunner rdfs:subClassOf base:Organization .

person:dale_northup a base:Person .

person:mark_nardi a base:Person .

position:general_counsel rdfs:subClassOf base:Person .

loc:401_b_street_suite_1100_san_diego_california_92101 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

loc:600_la_terraza_blvd_escondido_california_92025 a base:Location ;
    rel:isLocationOf org1:tauoperatingpartnershiplp .

loc:608_second_avenue_south_11th_floor_minneapolis_mn_55402 a base:Location ;
    rel:isLocationOf org1:wells_fargo_bank_national_association .

org1:tauoperatingpartnershiplp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:borrower ;
    rel:hasLocationAt loc:600_la_terraza_blvd_escondido_california_92025 .

org_role:guarantor rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

org1:wells_fargo_bank_national_association a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent ;
    rel:hasLocationAt loc:401_b_street_suite_1100_san_diego_california_92101,
        loc:608_second_avenue_south_11th_floor_minneapolis_mn_55402 .

org_role:arranger rdfs:subClassOf base:Organization .

org_role:borrower rdfs:subClassOf base:Organization .

org_role:bookrunners rdfs:subClassOf base:Organization .

org_role:arrangers rdfs:subClassOf base:Organization .

