person:seth_burroughs a base:Person ;
    <http://example.org/isInstanceOf/> position:executive_vice_president,
        position:secretary ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:xcel_brands_inc ;
            rel:position position:executive_vice_president ],
        [ a rel:Employment ;
            rel:organization org1:xcel_brands_inc ;
            rel:position position:secretary ] ;
    rel:isEmployedBy org1:xcel_brands_inc .

