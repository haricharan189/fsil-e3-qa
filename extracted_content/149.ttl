person:michelle_handy a base:Person ;
    <http://example.org/isInstanceOf/> position:managing_director ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:first_eagle_direct_lending_levered_fund_iv_spv_llc ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:first_eagle_direct_lending_v_c_scsp ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:first_eagle_direct_lending_fund_iv_llc ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:first_eagle_direct_lending_v_b_spv_llc ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:feac_agent_llc ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:first_eagle_direct_lending_iv_co_invest_llc ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:first_eagle_alternative_capital_bdc_inc ;
            rel:position position:managing_director ],
        [ a rel:Employment ;
            rel:organization org1:first_eagle_direct_lending_v_a_llc ;
            rel:position position:managing_director ] ;
    rel:isEmployedBy org1:feac_agent_llc,
        org1:first_eagle_alternative_capital_bdc_inc,
        org1:first_eagle_direct_lending_fund_iv_llc,
        org1:first_eagle_direct_lending_iv_co_invest_llc,
        org1:first_eagle_direct_lending_levered_fund_iv_spv_llc,
        org1:first_eagle_direct_lending_v_a_llc,
        org1:first_eagle_direct_lending_v_b_spv_llc,
        org1:first_eagle_direct_lending_v_c_scsp .

org_role:guarantor rdfs:subClassOf base:Organization .

