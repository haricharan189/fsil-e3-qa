    rdfs:subClassOf base:Location .

location_type:stamford_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:texas_banking_association a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:trade_finance a rdfs:Class ;
    rdfs:subClassOf base:Location .

location_type:uk_branch a rdfs:Class ;
    rdfs:subClassOf base:Location .

org1:botticelli_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:lender .

org1:claires_holdings_sa_rl a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:guarantor .

org_role:agent rdfs:subClassOf base:Organization .

loc:225_w_washington_street_21st_floor_chicago_il_60606 a base:Location ;
    rel:isLocationOf org1:cortland_capital_market_services_llc .

loc:245_park_avenue_26th_floor_new_york_new_york_10167 a base:Location ;
    rel:isLocationOf org1:botticelli_llc_c_o_angelo_gordonand_co_lp .

loc:3_sw_129th_avenue_suite_400_pembroke_pines_fl_33027 a base:Location ;
