org1:botticelli_llc_c_o_angelo_gordonand_co_lp a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent ;
    rel:hasLocationAt loc:245_park_avenue_26th_floor_new_york_new_york_10167 .

org_role:borrowers rdfs:subClassOf base:Organization .

org_role:collateral_agent rdfs:subClassOf base:Organization .

org_role:lender rdfs:subClassOf base:Organization .

person:gavin_baiera a base:Person ;
    <http://example.org/isInstanceOf/> position:authorized_signatory ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:angelo_gordonand_co_lp ;
            rel:position position:authorized_signatory ] ;
    rel:isEmployedBy org1:angelo_gordonand_co_lp .

