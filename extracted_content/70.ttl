person:eric_cohen a base:Person ;
    <http://example.org/isInstanceOf/> position:vice_president ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:fifth_third_bank ;
            rel:position position:vice_president ] ;
    rel:isEmployedBy org1:fifth_third_bank .

org1:greenbacker_renewable_energy_company_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:parent ;
    rel:hasEmployee person:richard_butt .

org1:greenbacker_renewable_energy_corporation a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:intermediate_holdco ;
    rel:hasEmployee person:richard_butt .

position:vice_president a base:Position ;
    base:positionName "VICE PRESIDENT" ;
    rdfs:subClassOf base:Person .

org1:fifth_third_bank a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:administrative_agent,
        org_role:arranger,
        org_role:bookrunner ;
    rel:hasEmployee person:eric_cohen ;
    rel:hasLocationAt loc:201_n_tryon_street_suite_1700_charlotte_north_carolina_28202 .

org1:grec_entity_holdco_llc a base:Organization ;
    <http://example.org/isInstanceOf/> org_role:subsidiaries_borrower ;
    rel:hasEmployee person:richard_butt ;
    rel:hasLocationAt loc:11_east_44th_street_suite_1200_new_york_ny_10017 .

person:richard_butt a base:Person ;
    <http://example.org/isInstanceOf/> position:chief_financial_officer ;
    rel:holdsPositionAt [ a rel:Employment ;
            rel:organization org1:greenbacker_renewable_energy_company_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:grec_entity_holdco_llc ;
            rel:position position:chief_financial_officer ],
        [ a rel:Employment ;
            rel:organization org1:greenbacker_renewable_energy_corporation ;
            rel:position position:chief_financial_officer ] ;
    rel:isEmployedBy org1:grec_entity_holdco_llc,
        org1:greenbacker_renewable_energy_company_llc,
        org1:greenbacker_renewable_energy_corporation .

position:chief_financial_officer a base:Position ;
    base:positionName "Chief Financial Officer" ;
    rdfs:subClassOf base:Person .

